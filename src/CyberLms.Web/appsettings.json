{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": { "AutoMigrate": true },
  "Authentication": {
    "Mode": "Local",
    "Windows": { "AutoProvision": true }
  },
  "Security": {
    "RequireHttpsCookies": true,
    "RedirectToHttps": true,
    "SessionHours": 8
  },
  "Storage": {
    "RootPath": "D:\\CyberLMS\\Storage",
    "MaxImageMB": 10,
    "MaxDocumentMB": 50,
    "MaxVideoMB": 500
  },
  "App": { "DisplayTimeZone": "Arab Standard Time" },
  "Smtp": { "Host": "", "Port": 25, "Sender": "", "SenderName": "", "Username": "", "Security": "Auto" },
  "Seed": { "AdminUsername": "", "AdminPassword": "" }
}
