{
  "_comment": "Copy to appsettings.Production.json ON THE SERVER (never commit it) and fill in every value marked <...>. Secrets may instead be set as machine environment variables (ConnectionStrings__Default, Smtp__Password).",
  "AllowedHosts": "<lms.company.local>",
  "ConnectionStrings": {
    "Default": "Host=<db-host>;Port=5432;Database=cyberlms;Username=cyberlms_app;Password=<app-role-password>;SSL Mode=<Prefer|Require|Disable>;Maximum Pool Size=50"
  },
  "Database": { "AutoMigrate": false },
  "Authentication": {
    "Mode": "Windows",
    "Windows": { "AutoProvision": true, "AllowedDomains": [ "<CORPDOMAIN>" ], "LookupDirectory": true, "LdapPath": "" }
  },
  "Storage": { "RootPath": "<D:\\AppData\\Uploads>", "MaxImageMB": 10, "MaxDocumentMB": 50, "MaxVideoMB": 500 },
  "Logging": { "File": { "Enabled": true, "Path": "<D:\\AppData\\Logs>", "RetentionDays": 30 } },
  "App": { "DisplayTimeZone": "Arab Standard Time", "BaseUrl": "https://<lms.company.local>" },
  "Smtp": {
    "Host": "<smtp/exchange relay host>", "Port": 25, "Sender": "<lms@company.local>", "SenderName": "<display name of sender>",
    "Username": "", "Password": "", "Security": "<Auto|None|StartTls|Ssl>"
  }
}
