@model TakeVm
@{
    ViewData["Title"] = Model.Assessment.Title;
    var n = 0;
    var total = Model.Questions.Count;
    var keys = L.IsRtl ? new[] { "أ", "ب", "ج", "د", "هـ", "و", "ز", "ح" } : new[] { "A", "B", "C", "D", "E", "F", "G", "H" };
}
<div class="quiz-layout">
    <section class="card quiz-intro reveal" data-quiz-intro>
        <span class="icon-chip"><i class="bi bi-ui-checks"></i></span>
        <h1 class="bidi">@Model.Assessment.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Assessment.Description)) { <p class="lead bidi">@Model.Assessment.Description</p> }
        <div class="quiz-facts">
            <div><strong>@Ui.Num(total)</strong><span>@L["Questions"]</span></div>
            <div><strong>@Ui.Pct(Model.Assessment.PassingPercentage)</strong><span>@L["Passing score"]</span></div>
            <div><strong>@Ui.Num(Model.Questions.Sum(q => q.Points))</strong><span>@L["Total points"]</span></div>
        </div>
        <ul class="quiz-rules">
            <li><i class="bi bi-check2-circle"></i><span>@L.Format("Instructions: answer all {0} questions, then submit. The passing score is {1}%.", total, Model.Assessment.PassingPercentage)</span></li>
            <li><i class="bi bi-arrow-left-right"></i><span>@L["You can move between questions freely before submitting."]</span></li>
            <li><i class="bi bi-keyboard"></i><span>@L["Tip: press the number keys 1-9 to choose an answer."]</span></li>
        </ul>
        <button type="button" class="btn btn-primary btn-lg" data-quiz-start><i class="bi bi-play-fill"></i> @L["Start now"]</button>
    </section>

    <div data-quiz-stage>
        <div class="quiz-bar">
            <span class="qb-title bidi">@Model.Assessment.Title</span>
            <div class="meter meter-lg" role="presentation"><span data-q-progress></span></div>
            <span class="qb-count" data-q-count data-format="@L["{0} of {1} answered"]" aria-live="polite">@L.Format("{0} of {1} answered", 0, total)</span>
        </div>
        <nav class="qnav" data-qnav data-label="@L["Question {0}"]" aria-label="@L["Questions"]"></nav>

        <form method="post" asp-action="Submit" asp-route-id="@Model.Attempt.Id" data-quiz data-confirm="@L["Submit your answers now? You cannot change them afterwards."]" novalidate>
        @foreach (var q in Model.Questions)
        {
            n++;
            var multi = q.Type == QuestionType.MultipleChoice;
            var tf = q.Type == QuestionType.TrueFalse;
            var k = 0;
            <fieldset class="card qcard qstep mb-3" id="step-@n">
                <div class="q-index"><i class="bi bi-question-circle-fill"></i> @L.Format("Question {0} of {1}", n, total)</div>
                <legend class="q-text bidi">@q.Text</legend>
                <div class="q-hint">
                    <span class="chip chip-primary"><i class="bi @(multi ? "bi-ui-checks" : "bi-ui-radios")"></i> @L[multi ? "Select all that apply" : "Select one answer"]</span>
                    <span class="chip"><i class="bi bi-star"></i> @L.Format("{0} point(s)", q.Points)</span>
                </div>
                <div class="choices @(tf ? "tf" : "")">
                @foreach (var o in q.Options.OrderBy(o => o.SortOrder))
                {
                    var isTrue = tf && o.Text == "True";
                    <label class="choice @(multi ? "is-multi" : "") @(tf ? (isTrue ? "tf-true" : "tf-false") : "")" for="o_@o.Id">
                        <input type="@(multi ? "checkbox" : "radio")" name="q_@q.Id" id="o_@o.Id" value="@o.Id" />
                        <span class="ch-key" aria-hidden="true">@if (tf) { <i class="bi @(isTrue ? "bi-check-lg" : "bi-x-lg")"></i> } else { @keys[k % keys.Length] }</span>
                        <span class="ch-text bidi">@(tf ? L[o.Text] : o.Text)</span>
                        <span class="ch-mark" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                    </label>
                    k++;
                }
                </div>
            </fieldset>
        }
            <div class="alert alert-warning unanswered-note" role="alert"><i class="bi bi-exclamation-triangle-fill"></i><span>@L["Some questions are not answered yet:"] <bdi data-missing></bdi>. @L["Unanswered questions are marked wrong. Press submit again to send anyway."]</span></div>
            <div class="quiz-foot">
                <button type="button" class="btn btn-outline-secondary" data-q-prev><i class="bi bi-arrow-right-short flip-rtl"></i> @L["Previous"]</button>
                <button type="button" class="btn btn-primary" data-q-next>@L["Next"] <i class="bi bi-arrow-left-short flip-rtl"></i></button>
                <button class="btn btn-primary btn-lg" data-q-submit><i class="bi bi-send"></i> @L["Submit answers"]</button>
            </div>
        </form>
    </div>
</div>
