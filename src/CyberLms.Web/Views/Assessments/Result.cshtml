@model ResultVm
@{
    var a = Model.Attempt; ViewData["Title"] = a.Assessment.Title; var n = 0;
    var pass = a.Passed == true;
}
<div class="quiz-layout">
    <section class="result-hero @(pass ? "pass" : "fail") reveal">
        @if (pass) { <div class="burst" aria-hidden="true"></div> }
        <h1 class="bidi">@a.Assessment.Title</h1>
        @Ui.Ring((double)a.Percentage, L["Your result"], size: 196, stroke: 12, mark: a.PassingPercentageSnapshot)
        <div><span class="result-status" role="status"><i class="bi @(pass ? "bi-patch-check-fill" : "bi-x-octagon-fill")"></i> @L[pass ? "Passed" : "Failed"]</span></div>
        <p class="result-msg">@L[pass ? "Congratulations, you passed this assessment." : "You did not reach the passing score. Review the material and try again if attempts remain."]</p>
        <div class="result-stats">
            <div><strong>@Ui.Num(a.CorrectAnswers) <small class="text-muted fs-6 fw-normal">@L.Format("of {0}", a.TotalQuestions)</small></strong><span>@L["Correct answers"]</span></div>
            <div><strong>@Ui.Pct(a.PassingPercentageSnapshot)</strong><span>@L["Passing score"]</span></div>
            <div><strong>@Ui.Num(a.EarnedPoints) <small class="text-muted fs-6 fw-normal">@L.Format("of {0}", a.TotalPoints)</small></strong><span>@L["Points"]</span></div>
            <div><strong class="fs-6 d-block pt-2">@Time.Html(a.CompletedAt)</strong><span>@L["Assessment date"]</span></div>
        </div>
        <div class="cluster justify-content-center">
            @if (Model.CanRetry) { <form method="post" asp-action="Start" asp-route-id="@a.AssessmentId" class="m-0"><button class="btn btn-primary btn-lg"><i class="bi bi-arrow-repeat"></i> @L["Retry"]</button></form> }
            @if (!pass && a.Assessment.ContentId != null) { <a class="btn btn-outline-primary btn-lg" asp-controller="Content" asp-action="Details" asp-route-id="@a.Assessment.ContentId"><i class="bi bi-journal-text"></i> @L["Review the material"]</a> }
            <a class="btn btn-outline-secondary btn-lg" asp-action="Index">@L["Back to assessments"]</a>
        </div>
    </section>

    <div class="section-title"><h2><i class="bi bi-card-checklist"></i> @L["Answer review"]</h2><span class="chip"><span class="text-success fw-bold">@Model.Answers.Values.Count(x => x.IsCorrect)</span>&nbsp;@L["Correct"] · <span class="text-danger fw-bold">@Model.Answers.Values.Count(x => !x.IsCorrect)</span>&nbsp;@L["Incorrect"]</span></div>
    <div class="review">
    @foreach (var q in Model.Questions)
    {
        n++;
        var ans = Model.Answers[q.Id];
        <details class="reveal-scroll" style="--i:@(n % 4)">
            <summary>
                <span class="icon-chip @(ans.IsCorrect ? "success" : "danger")"><i class="bi @(ans.IsCorrect ? "bi-check-lg" : "bi-x-lg")"></i></span>
                <span class="bidi flex-grow-1"><small class="text-muted d-block fw-normal">@L.Format("Question {0} of {1}", n, Model.Questions.Count)</small>@q.Text</span>
                <span class="badge text-bg-@(ans.IsCorrect ? "success" : "danger")">@L[ans.IsCorrect ? "Correct" : "Incorrect"]</span>
                <i class="bi bi-chevron-down"></i>
            </summary>
            <div class="rv-body">
                @L["Your answer"]: <strong class="bidi @(ans.IsCorrect ? "rv-ok" : "rv-bad")">@(ans.SelectedOptionIds.Length == 0 ? L["No answer"] : string.Join(L.Sep, q.Options.Where(o => ans.SelectedOptionIds.Contains(o.Id)).Select(o => q.Type == QuestionType.TrueFalse ? L[o.Text] : o.Text)))</strong>
                · @L.Format("{0} point(s)", ans.PointsAwarded)
            </div>
        </details>
    }
    </div>
</div>
