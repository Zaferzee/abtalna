@model ResultVm
@{ var a = Model.Attempt; ViewData["Title"] = a.Assessment.Title; var n = 0; }
<h1 class="h5 bidi mb-3">@a.Assessment.Title</h1>
<div class="card mb-3 border-@(a.Passed == true ? "success" : "danger")"><div class="card-body text-center py-4">
    <div class="text-muted">@L["Your result"]</div>
    <div class="display-4 fw-bold text-@(a.Passed == true ? "success" : "danger")">@a.Percentage.ToString("0.#")%</div>
    <div class="fs-4"><span class="badge text-bg-@(a.Passed == true ? "success" : "danger")">@L[a.Passed == true ? "Passed" : "Failed"]</span></div>
    <p class="mt-2 mb-0 fs-6">@L[a.Passed == true ? "Congratulations, you passed this assessment." : "You did not reach the passing score. Review the material and try again if attempts remain."]</p>
    <div class="mt-2 text-muted">@L["Correct answers"]: @a.CorrectAnswers / @a.TotalQuestions &middot; @L["Passing score"]: @a.PassingPercentageSnapshot% &middot; @Time.Html(a.CompletedAt)</div>
    <div class="mt-3">
        @if (Model.CanRetry) { <form method="post" asp-action="Start" asp-route-id="@a.AssessmentId" class="d-inline"><button class="btn btn-primary">@L["Retry"]</button></form> }
        <a class="btn btn-outline-secondary" asp-action="Index">@L["Back to assessments"]</a>
    </div>
</div></div>
@foreach (var q in Model.Questions)
{
    n++;
    var ans = Model.Answers[q.Id];
    <div class="card question-card mb-2"><div class="card-body">
        <div class="d-flex justify-content-between gap-2"><div class="fw-semibold bidi">@n. @q.Text</div><span class="badge text-bg-@(ans.IsCorrect ? "success" : "danger") align-self-start">@L[ans.IsCorrect ? "Correct" : "Incorrect"]</span></div>
        <div class="small text-muted mt-1">@L["Your answer"]: <span class="bidi">@(ans.SelectedOptionIds.Length == 0 ? L["No answer"] : string.Join(L.Sep, q.Options.Where(o => ans.SelectedOptionIds.Contains(o.Id)).Select(o => q.Type == QuestionType.TrueFalse ? L[o.Text] : o.Text)))</span></div>
    </div></div>
}
