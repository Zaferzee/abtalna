@model List<AssessmentListItem>
@{ ViewData["Title"] = L["Assessments"]; var i = 0; }
<div class="page-head reveal">
    <div>
        <div class="eyebrow"><i class="bi bi-patch-question"></i> @L["Learning"]</div>
        <h1>@L["Assessments"]</h1>
        <p class="lead">@L["Short assessments that check your understanding of the policies and controls."]</p>
    </div>
</div>
@if (Model.Count == 0)
{
    <div class="lx-empty"><span class="lx-empty-icon muted"><i class="bi bi-patch-question"></i></span><div><h3>@L["There are no assessments available right now."]</h3><p>@L["New assessments will appear here when they are published."]</p></div></div>
}
<div class="grid-auto" style="--min:320px">
@foreach (var it in Model)
{
    var a = it.Assessment;
    var passed = it.Best?.Passed == true;
    var locked = it.LockedByAck && !passed;
    <article class="card quiz-card @(passed ? "is-passed" : "") @(locked ? "is-locked" : "") reveal" style="--i:@(i++)">
        <div class="q-band"></div>
        <div class="q-body">
            <div class="d-flex align-items-center justify-content-between gap-2">
                <span class="icon-chip @(passed ? "success" : "accent")"><i class="bi @(passed ? "bi-patch-check-fill" : "bi-ui-checks")"></i></span>
                @if (passed) { <span class="badge text-bg-success badge-dot">@L["Passed"]</span> }
                else if (locked) { <span class="badge text-bg-secondary"><i class="bi bi-lock-fill"></i> @L["Locked"]</span> }
                else if (it.HasInProgress) { <span class="badge text-bg-warning badge-dot">@L["In progress"]</span> }
                else if (it.Best != null) { <span class="badge text-bg-danger badge-dot">@L["Not passed yet"]</span> }
                else { <span class="badge text-bg-secondary">@L["New"]</span> }
            </div>
            <h3 class="bidi">@a.Title</h3>
            @if (a.Content?.Status == ContentStatus.Published) { <a class="lx-linked bidi" asp-controller="Content" asp-action="Details" asp-route-id="@a.ContentId"><i class="bi bi-link-45deg"></i> @a.Content.Title</a> }
            @if (!string.IsNullOrWhiteSpace(a.Description)) { <p class="bidi">@a.Description</p> }
            <div class="status-chips mt-auto">
                <span class="chip"><i class="bi bi-question-circle"></i> @L.Format("{0} question(s)", it.QuestionCount)</span>
                <span class="chip"><i class="bi bi-bullseye"></i> @L["Passing score"]: @Ui.Pct(a.PassingPercentage)</span>
                <span class="chip"><i class="bi bi-arrow-repeat"></i> @L["Attempts"]: <bdi dir="ltr">@it.CompletedAttempts / @(a.MaxAttempts == 0 ? "∞" : a.MaxAttempts.ToString())</bdi></span>
            </div>
            @if (it.Best != null)
            {
                <div class="score-cell mt-1"><small class="text-muted text-nowrap">@L["Best score"]</small><div class="meter"><span class="@(passed ? "ok" : "bad")" data-w="@it.Best.Percentage"></span></div>@Ui.Pct((double)it.Best.Percentage)</div>
            }
        </div>
        <div class="q-foot">
            @if (locked)
            {
                <span class="lock-note"><i class="bi bi-lock-fill"></i> @L["Complete the acknowledgment first"]</span>
                @if (a.Content?.Status == ContentStatus.Published)
                {
                    <a class="btn btn-outline-primary" asp-controller="Content" asp-action="Details" asp-route-id="@a.ContentId" asp-fragment="sec-ack"><i class="bi bi-pen"></i> @L["Read and acknowledge"]</a>
                }
            }
            else if (passed)
            {
                @* Passed: the item is complete. The result is the primary action; a retake stays possible only where an attempt was
                   already started (the existing rule still allows new attempts within MaxAttempts on the server). *@
                <a class="btn btn-success" asp-action="Result" asp-route-id="@it.Best!.Id"><i class="bi bi-award"></i> @L["View result"]</a>
                @if (it.HasInProgress)
                {
                    <form method="post" asp-action="Start" asp-route-id="@a.Id" class="m-0"><button class="btn btn-link btn-sm p-0">@L["Continue the open attempt"]</button></form>
                }
                else
                {
                    <span class="lock-note text-success"><i class="bi bi-patch-check-fill"></i> @L["Completed"]</span>
                }
            }
            else if (it.CanStart)
            {
                <form method="post" asp-action="Start" asp-route-id="@a.Id" class="m-0"><button class="btn btn-primary"><i class="bi bi-play-fill"></i> @L[it.HasInProgress ? "Continue assessment" : (it.CompletedAttempts > 0 ? "Retry" : "Start assessment")]</button></form>
                <small class="text-muted">@(a.MaxAttempts == 0 ? L["Unlimited"] : L.Format("{0} attempt(s) left", Math.Max(0, a.MaxAttempts - it.CompletedAttempts)))</small>
            }
            else
            {
                <span class="text-muted small"><i class="bi bi-lock"></i> @L["Maximum attempts reached"]</span>
            }
        </div>
    </article>
}
</div>
