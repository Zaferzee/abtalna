@model ContentDetailsVm
@{ var c = Model.Content; ViewData["Title"] = c.Title; var policyLike = Labels.IsPolicyLike(c.Type); if (policyLike) { ViewData["Nav"] = "Policies"; } }
<div class="read-progress" aria-hidden="true"></div>
@if (Model.Preview) { <div class="alert alert-warning"><i class="bi bi-eye"></i><span>@L["Preview: this content is not published (visible to administrators only)."]</span></div> }
<nav aria-label="@L["Breadcrumb trail"]"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-action="@(policyLike ? "Policies" : "Index")">@L[policyLike ? "Policies" : "Content"]</a></li>
    <li class="breadcrumb-item active bidi" aria-current="page">@c.Title</li>
</ol></nav>
<partial name="_ContentReader" model="Model" />
