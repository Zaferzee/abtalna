@model ContentIndexVm
@{ ViewData["Title"] = Model.PoliciesOnly ? L["Policies"] : L["Content"]; }
<h1 class="h4 mb-3">@ViewData["Title"]</h1>
<form class="row g-2 mb-3" method="get">
    <div class="col-12 col-md-5"><input class="form-control" name="q" value="@Model.Q" placeholder="@L["Search"]" /></div>
    @if (!Model.PoliciesOnly)
    {
        <div class="col-8 col-md-4"><select class="form-select" name="type"><option value="">@L["All"]</option>
            @foreach (var t in Enum.GetValues<ContentType>()) { <option value="@((int)t)" selected="@(Model.Type == t)">@L[Labels.Type(t)]</option> }</select></div>
    }
    <div class="col-4 col-md-2"><button class="btn btn-primary w-100">@L["Search"]</button></div>
</form>
@if (Model.Items.Count == 0) { <div class="text-muted">@L["Nothing here yet."]</div> }
<div class="row g-3">
@foreach (var c in Model.Items)
{
    <div class="col-md-6 col-xl-4"><div class="card h-100"><div class="card-body d-flex flex-column">
        <div class="mb-1"><span class="badge text-bg-light">@L[Labels.Type(c.Type)]</span>
            @if (c.RequiresAcknowledgment) { <span class="badge text-bg-@(Model.AcknowledgedIds.Contains(c.Id) ? "success" : "warning")">@L[Model.AcknowledgedIds.Contains(c.Id) ? "Acknowledged" : "Not acknowledged"]</span> }</div>
        <h2 class="h6 bidi"><a class="text-decoration-none" asp-action="Details" asp-route-id="@c.Id">@c.Title</a></h2>
        <p class="text-muted small bidi flex-grow-1">@c.Description</p>
        <div class="d-flex justify-content-between align-items-center"><small class="text-muted">@Time.Format(c.PublishedAt)</small><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@c.Id">@L["View"]</a></div>
    </div></div></div>
}
</div>
