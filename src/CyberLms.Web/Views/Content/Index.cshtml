@model ContentIndexVm
@{ ViewData["Title"] = Model.PoliciesOnly ? L["Policies"] : L["Content"]; var i = 0; var pending = Model.Items.Count(c => c.RequiresAcknowledgment && !Model.AcknowledgedIds.Contains(c.Id)); }
<div class="page-head reveal">
    <div>
        <div class="eyebrow"><i class="bi @(Model.PoliciesOnly ? "bi-shield-check" : "bi-journal-text")"></i> @L["Learning"]</div>
        <h1>@ViewData["Title"]</h1>
        <p class="lead">@L[Model.PoliciesOnly ? "Policies and regulations you are expected to read and acknowledge." : "Policies, controls, awareness and training material published for you."]</p>
    </div>
    @if (pending > 0) { <span class="chip chip-warning"><i class="bi bi-pen"></i> @L.Format("{0} awaiting your acknowledgment", pending)</span> }
</div>
<form class="panel toolbar mb-4 reveal" style="--i:1" method="get" role="search">
    <div class="search"><i class="bi bi-search"></i><input class="form-control" name="q" value="@Model.Q" placeholder="@L["Search by title or description"]" aria-label="@L["Search"]" /></div>
    @if (!Model.PoliciesOnly)
    {
        <select class="form-select" name="type" aria-label="@L["Content type"]"><option value="">@L["All types"]</option>
            @foreach (var t in Labels.TypeOrder) { <option value="@((int)t)" selected="@(Model.Type == t)">@L[Labels.Type(t)]</option> }</select>
    }
    <div class="tb-end"><button class="btn btn-primary"><i class="bi bi-search"></i> @L["Search"]</button></div>
</form>
@if (Model.Items.Count == 0)
{
    <div class="panel empty"><div class="empty-icon"><i class="bi bi-journal"></i></div><h3>@L[string.IsNullOrEmpty(Model.Q) ? "No content has been published yet." : "No results."]</h3></div>
}
<div class="grid-auto" style="--min:290px">
@foreach (var c in Model.Items)
{
    <div class="reveal" style="--i:@(Math.Min(i++, 8))"><partial name="_ContentCard" model="Model.Learning[c.Id]" /></div>
}
</div>
