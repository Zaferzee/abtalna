@{
    var b = Brand.Current;
    var isAdminArea = (string?)ViewContext.RouteData.Values["area"] == "Admin";
    var ctl = (string?)ViewContext.RouteData.Values["controller"];
    var act = (string?)ViewContext.RouteData.Values["action"];
    var isAdmin = User.IsInRole(RoleNames.Admin);
    var displayName = User.FindFirst("display_name")?.Value ?? User.Identity?.Name ?? "";
    var initial = displayName.Trim().Length > 0 ? displayName.Trim()[0].ToString() : "؟";
    var monogram = b.SystemName.Trim().Length > 0 ? b.SystemName.Trim()[0].ToString() : "•";
    string Active(string c, bool admin = false) => ctl == c && isAdminArea == admin ? "active" : "";
    string Aria(string c, bool admin = false) => ctl == c && isAdminArea == admin ? "page" : "false";
}
<!DOCTYPE html>
<html lang="@L.Lang" dir="@L.Dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - " : "")@b.SystemName</title>
    @if (b.HasFavicon) { <link rel="icon" href="~/Files/Brand?kind=favicon&v=@b.Version" /> }
    <link rel="stylesheet" href="~/lib/bootstrap/@(L.IsRtl ? "bootstrap.rtl.min.css" : "bootstrap.min.css")" />
    <link rel="stylesheet" href="~/lib/icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ds.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/branding/theme.css?v=@b.Version" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="app @(isAdminArea ? "is-admin" : "is-portal")" data-t-confirm="@L["Confirm"]" data-t-cancel="@L["Cancel"]" data-t-confirm-title="@L["Confirmation"]"
      data-t-choose-file="@L["Choose file"]" data-t-choose-files="@L["Choose files"]" data-t-no-file="@L["No file chosen"]" data-t-files-count="@L["{0} files selected"]"
      data-t-upload-failed="@L["Image upload failed."]" data-t-quill="@L["Editor toolbar"]">
<a class="skip-link" href="#main">@L["Skip to content"]</a>
<div class="shell">
    <aside class="sidebar scrollbar-soft" id="sidebar" aria-label="@L["Main menu"]">
        <a class="sb-brand" href="~/">
            @if (b.HasLogo) { <span class="sb-logo"><img src="~/Files/Brand?kind=logo&v=@b.Version" alt="@b.OrgName" /></span> }
            else { <span class="sb-mono" aria-hidden="true">@monogram</span> }
            <span class="sb-names"><strong>@b.SystemName</strong><small>@b.OrgName</small></span>
        </a>
        <nav class="sb-nav">
            @if (isAdmin && isAdminArea)
            {
                <div class="sb-label">@L["Overview"]</div>
                <a class="sb-link @Active("Dashboard", true)" aria-current="@Aria("Dashboard", true)" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i><span>@L["Dashboard"]</span></a>
                <div class="sb-label">@L["Manage"]</div>
                <a class="sb-link @Active("Content", true)" aria-current="@Aria("Content", true)" asp-area="Admin" asp-controller="Content" asp-action="Index"><i class="bi bi-journal-richtext"></i><span>@L["Content Management"]</span></a>
                <a class="sb-link @Active("Assessments", true)" aria-current="@Aria("Assessments", true)" asp-area="Admin" asp-controller="Assessments" asp-action="Index"><i class="bi bi-patch-question"></i><span>@L["Assessments"]</span></a>
                <a class="sb-link @Active("Users", true)" aria-current="@Aria("Users", true)" asp-area="Admin" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i><span>@L["Users"]</span></a>
                <div class="sb-label">@L["Insights"]</div>
                <a class="sb-link @Active("Reports", true)" aria-current="@Aria("Reports", true)" asp-area="Admin" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line"></i><span>@L["Reports"]</span></a>
                <a class="sb-link @Active("Audit", true)" aria-current="@Aria("Audit", true)" asp-area="Admin" asp-controller="Audit" asp-action="Index"><i class="bi bi-clock-history"></i><span>@L["Audit log"]</span></a>
                <div class="sb-label">@L["System"]</div>
                <a class="sb-link @Active("Settings", true)" aria-current="@Aria("Settings", true)" asp-area="Admin" asp-controller="Settings" asp-action="Index"><i class="bi bi-palette2"></i><span>@L["Settings"]</span></a>
            }
            else
            {
                <div class="sb-label">@L["Learning"]</div>
                <a class="sb-link @Active("Home")" aria-current="@Aria("Home")" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-heart"></i><span>@L["Dashboard"]</span></a>
                <a class="sb-link @(ctl == "Content" && act != "Policies" && !isAdminArea ? "active" : "")" asp-area="" asp-controller="Content" asp-action="Index"><i class="bi bi-journal-text"></i><span>@L["Content"]</span></a>
                <a class="sb-link @(ctl == "Content" && act == "Policies" && !isAdminArea ? "active" : "")" asp-area="" asp-controller="Content" asp-action="Policies"><i class="bi bi-shield-check"></i><span>@L["Policies"]</span></a>
                <a class="sb-link @Active("Assessments")" aria-current="@Aria("Assessments")" asp-area="" asp-controller="Assessments" asp-action="Index"><i class="bi bi-patch-question"></i><span>@L["Assessments"]</span></a>
                <a class="sb-link @Active("MyResults")" aria-current="@Aria("MyResults")" asp-area="" asp-controller="MyResults" asp-action="Index"><i class="bi bi-award"></i><span>@L["My Results"]</span></a>
            }
        </nav>
        <div class="sb-foot">
            @if (isAdmin)
            {
                @if (isAdminArea) { <a class="sb-switch" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-person-workspace"></i><span>@L["Employee portal"]</span><i class="bi bi-arrow-left-short ms-auto flip-rtl"></i></a> }
                else { <a class="sb-switch" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-sliders"></i><span>@L["Administration"]</span><i class="bi bi-arrow-left-short ms-auto flip-rtl"></i></a> }
            }
            <div class="sb-user">
                <span class="avatar avatar-sm">@initial</span>
                <span class="sb-user-names"><strong class="bidi">@displayName</strong><small>@L[isAdmin ? "Role: Administrator" : "Role: Employee"]</small></span>
            </div>
        </div>
    </aside>
    <div class="sb-backdrop" data-sidebar-close></div>

    <div class="shell-main">
        <header class="topbar">
            <button class="btn btn-ghost btn-icon d-lg-none" type="button" data-sidebar-toggle aria-controls="sidebar" aria-label="@L["Menu"]"><i class="bi bi-list fs-4"></i></button>
            <div class="topbar-title">
                <span class="topbar-section">@L[isAdminArea ? "Administration" : "Employee portal"]</span>
                @if (ViewData["Title"] != null) { <i class="bi bi-chevron-left topbar-sep flip-ltr" aria-hidden="true"></i><span class="topbar-page bidi">@ViewData["Title"]</span> }
            </div>
            <div class="topbar-actions">
                <form method="post" asp-controller="Account" asp-action="SetLanguage" asp-area="" class="m-0">
                    <input type="hidden" name="lang" value="@(L.IsRtl ? "en" : "ar")" />
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button class="btn btn-ghost btn-sm lang-btn" title="@L["Language"]" lang="@(L.IsRtl ? "en" : "ar")"><i class="bi bi-translate"></i> @(L.IsRtl ? "English" : "العربية")</button>
                </form>
                <div class="dropdown">
                    <button class="user-chip" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar avatar-sm">@initial</span><span class="d-none d-md-inline bidi">@displayName</span><i class="bi bi-chevron-down small"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li class="px-3 py-2"><div class="fw-bold bidi">@displayName</div><div class="small text-muted" dir="ltr">@User.Identity?.Name</div></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword" asp-area=""><i class="bi bi-key"></i> @L["Change password"]</a></li>
                        <li><form method="post" asp-controller="Account" asp-action="Logout" asp-area=""><button class="dropdown-item"><i class="bi bi-box-arrow-left"></i> @L["Sign out"]</button></form></li>
                    </ul>
                </div>
            </div>
        </header>
        <main id="main" class="page" tabindex="-1">
            @if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show reveal" role="status"><i class="bi bi-check-circle-fill"></i><span>@L[ok]</span><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Close"]"></button></div> }
            @if (TempData["Error"] is string er) { <div class="alert alert-danger alert-dismissible fade show reveal" role="alert"><i class="bi bi-exclamation-octagon-fill"></i><span>@L[er]</span><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Close"]"></button></div> }
            @RenderBody()
        </main>
        @if (!string.IsNullOrWhiteSpace(b.FooterText)) { <footer class="app-footer bidi">@b.FooterText</footer> }
    </div>
</div>

<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true" aria-labelledby="confirmModalTitle">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header pb-0"><div><div class="modal-icon"><i class="bi bi-question-lg"></i></div><h2 class="modal-title fs-5" id="confirmModalTitle">@L["Confirmation"]</h2></div><button type="button" class="btn-close align-self-start" data-bs-dismiss="modal" aria-label="@L["Close"]"></button></div>
        <div class="modal-body" id="confirmModalText"></div>
        <div class="modal-footer"><button type="button" class="btn btn-primary" id="confirmModalOk">@L["Confirm"]</button><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Cancel"]</button></div>
    </div></div>
</div>

<script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("PreScripts", required: false)
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/ui.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
