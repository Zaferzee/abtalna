@model CyberLms.Web.Models.Pager
@if (Model.Pages > 1)
{
    var q = Context.Request.Query.Where(k => k.Key != "page").SelectMany(k => k.Value.Select(v => (k.Key, v))).ToList();
    string Link(int p) => "?" + string.Join("&", q.Select(x => $"{Uri.EscapeDataString(x.Key)}={Uri.EscapeDataString(x.v ?? "")}").Append($"page={p}"));
    <nav class="mt-3 d-flex flex-wrap align-items-center gap-3" aria-label="@L["Pagination"]">
        <ul class="pagination pagination-sm flex-wrap mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page - 1)">@L["Previous"]</a></li>
            @for (var p = Math.Max(1, Model.Page - 3); p <= Math.Min(Model.Pages, Model.Page + 3); p++)
            { <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@Link(p)">@p</a></li> }
            <li class="page-item @(Model.Page >= Model.Pages ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page + 1)">@L["Next"]</a></li>
        </ul>
        <span class="text-muted small">@L.Format("Page {0} of {1}", Model.Page, Model.Pages) &middot; @L.Format("Total: {0}", Model.Total)</span>
    </nav>
}
