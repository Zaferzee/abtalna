@model ErrorVm
@{
    ViewData["Title"] = L["Error"];
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_LayoutBare";
    var (title, text) = Model.Code switch
    {
        404 => ("Page not found", "The page you requested does not exist or is not available to you."),
        403 => ("Access denied", "You do not have permission to view this page."),
        400 => ("Invalid request", "The request could not be processed. Your session may have expired; please reload the page and try again."),
        401 => ("Sign-in required", "Please sign in to continue."),
        413 => ("File too large", "The uploaded file or request is larger than the allowed size. Choose a smaller file."),
        503 => ("Service temporarily unavailable", "The system cannot reach its database at the moment. Please try again shortly; the details have been recorded in the server log."),
        _ => ("Unexpected error", "An unexpected error occurred. Please try again or contact the administrator."),
    };
}
<div class="@(User.Identity?.IsAuthenticated == true ? "" : "card")"><div class="@(User.Identity?.IsAuthenticated == true ? "" : "card-body p-4")">
    <h1 class="h4"><i class="bi bi-exclamation-triangle text-warning"></i> @L[title]</h1>
    <p>@L[text]</p>
    <p class="text-muted small">@L["Reference"]: <code dir="ltr">@Model.RequestId</code></p>
    <a class="btn btn-primary" href="~/">@L["Back to home"]</a>
</div></div>
