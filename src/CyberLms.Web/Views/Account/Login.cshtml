@model LoginVm
@{
    Layout = null;
    var b = Brand.Current;
    var auth = (AuthService)ViewBag.Auth;
    var hasErrors = !ViewData.ModelState.IsValid;
    var logoInCard = b.HasLoginLogo && b["LoginLogoPlacement"] is "card" or "both";
}
<!DOCTYPE html>
<html lang="@L.Lang" dir="@L.Dir">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@b.LoginTitle - @b.SystemNameInline</title>
    @if (b.HasFavicon) { <link rel="icon" href="~/Files/Brand?kind=favicon&v=@b.Version" /> }
    <link rel="stylesheet" href="~/lib/bootstrap/@(L.IsRtl ? "bootstrap.rtl.min.css" : "bootstrap.min.css")" />
    <link rel="stylesheet" href="~/lib/icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ds.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/branding/theme.css?v=@b.Version" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
</head>
<body class="auth-body">
<a class="skip-link" href="#login-form">@L["Skip to content"]</a>
<div class="auth @b.LoginClasses">
    <partial name="_LoginHero" model="b" />

    <section class="auth-panel">
        <div class="auth-card reveal" style="--i:2">
            @if (logoInCard) { <div class="auth-card-logo"><img src="@b.LoginLogoUrl" alt="@b.OrgNameInline" /></div> }
            <h2 class="bidi">@b.LoginTitle</h2>
            <p class="auth-sub bidi">@b["LoginCardSubtitle"]</p>
            @if (!string.IsNullOrWhiteSpace(b.LoginSubtitle)) { <div class="alert alert-info bidi"><i class="bi bi-info-circle-fill"></i><span class="ml">@b.LoginSubtitle</span></div> }
            @if (ViewBag.SignedOut == true) { <div class="alert alert-success" role="status"><i class="bi bi-check-circle-fill"></i><span>@L["You have been signed out."]</span></div> }
            @if (TempData["Error"] is string te) { <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-octagon-fill"></i><span>@te</span></div> }
            @if (Model.Error != null) { <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-octagon-fill"></i><span>@Model.Error</span></div> }
            @if (hasErrors) { <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-octagon-fill"></i><div asp-validation-summary="All"></div></div> }
            @if (auth.LocalEnabled)
            {
                <form method="post" asp-action="Login" id="login-form" data-busy novalidate>
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div class="mb-3">
                        <label class="form-label" asp-for="Username">@L["Username"]</label>
                        <div class="field-icon"><i class="bi bi-person"></i><input class="form-control" asp-for="Username" autocomplete="username" autofocus dir="ltr" /></div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label" asp-for="Password">@L["Password"]</label>
                        <div class="field-icon"><i class="bi bi-lock"></i><input class="form-control" asp-for="Password" autocomplete="current-password" dir="ltr" />
                            <button type="button" class="pw-toggle" data-pw-toggle="Password" aria-pressed="false" aria-label="@L["Show password"]" data-show="@L["Show password"]" data-hide="@L["Hide password"]"><i class="bi bi-eye"></i></button></div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100">@L["Sign in"] <i class="bi bi-arrow-left-short flip-rtl"></i></button>
                </form>
            }
            @if (auth.WindowsEnabled)
            {
                @if (auth.LocalEnabled) { <div class="auth-or">@L["or"]</div> }
                <a class="btn btn-outline-primary btn-lg w-100" asp-action="WindowsLogin" asp-route-returnUrl="@Model.ReturnUrl"><i class="bi bi-windows"></i> @L["Sign in with Windows account"]</a>
            }
            <div class="auth-secure"><i class="bi bi-shield-check"></i> @L["Protected connection - for authorized users only"]</div>
            @if (!string.IsNullOrWhiteSpace(b["SupportText"])) { <div class="auth-support ml bidi"><i class="bi bi-headset"></i> <span>@b["SupportText"]</span></div> }
        </div>
        <div class="auth-foot">
            <form method="post" asp-action="SetLanguage" class="m-0">
                <input type="hidden" name="lang" value="@(L.IsRtl ? "en" : "ar")" /><input type="hidden" name="returnUrl" value="/Account/Login" />
                <button class="btn btn-ghost btn-sm" lang="@(L.IsRtl ? "en" : "ar")"><i class="bi bi-translate"></i> @(L.IsRtl ? "English" : "العربية")</button>
            </form>
            <span class="bidi">@b.FooterText</span>
        </div>
    </section>
</div>
<script src="~/js/ui.js" asp-append-version="true"></script>
</body>
</html>
