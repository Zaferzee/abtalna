@model ChangePasswordVm
@{ ViewData["Title"] = L["Change password"]; }
<div class="narrow-page">
<div class="page-head reveal">
    <div>
        <div class="eyebrow"><i class="bi bi-shield-lock"></i> @L["Account"]</div>
        <h1>@L["Change password"]</h1>
    </div>
</div>
@if (User.FindFirst("must_change_password")?.Value == "1") { <div class="alert alert-info"><i class="bi bi-info-circle-fill"></i><span>@L["You must change your password before continuing."]</span></div> }
<section class="panel reveal" style="--i:1"><div class="panel-body">
<form method="post" novalidate data-busy>
    <div asp-validation-summary="All" class="validation-summary-errors"></div>
    @if ((bool)ViewBag.Local)
    {
        <div class="mb-3"><label class="form-label" asp-for="Current">@L["Current password"]</label><div class="field-icon"><i class="bi bi-key"></i><input class="form-control" asp-for="Current" autocomplete="current-password" dir="ltr" /></div></div>
        <div class="mb-3"><label class="form-label" asp-for="New">@L["New password"]</label><div class="field-icon"><i class="bi bi-lock"></i><input class="form-control" asp-for="New" autocomplete="new-password" dir="ltr" /></div><div class="form-text">@L["Minimum 10 characters, with upper-case, lower-case and a digit."]</div></div>
        <div class="mb-4"><label class="form-label" asp-for="Confirm">@L["Confirm new password"]</label><div class="field-icon"><i class="bi bi-lock-fill"></i><input class="form-control" asp-for="Confirm" autocomplete="new-password" dir="ltr" /></div></div>
        <button class="btn btn-primary btn-lg"><i class="bi bi-check2"></i> @L["Save"]</button>
    }
    else { <p class="mb-0"><i class="bi bi-windows text-primary"></i> @L["This account signs in with Windows; no password to change."]</p> }
</form></div></section>
</div>
