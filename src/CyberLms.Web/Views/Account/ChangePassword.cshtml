@model ChangePasswordVm
@{ ViewData["Title"] = L["Change password"]; }
<h1 class="h4 mb-3">@L["Change password"]</h1>
@if (User.FindFirst("must_change_password")?.Value == "1") { <div class="alert alert-info">@L["You must change your password before continuing."]</div> }
<div class="card" style="max-width:480px"><div class="card-body">
<form method="post" novalidate>
    <div asp-validation-summary="All" class="text-danger mb-2"></div>
    @if ((bool)ViewBag.Local)
    {
        <div class="mb-3"><label class="form-label" asp-for="Current">@L["Current password"]</label><input class="form-control" asp-for="Current" autocomplete="current-password" dir="ltr" /></div>
        <div class="mb-3"><label class="form-label" asp-for="New">@L["New password"]</label><input class="form-control" asp-for="New" autocomplete="new-password" dir="ltr" /><div class="form-text">@L["Minimum 10 characters, with upper-case, lower-case and a digit."]</div></div>
        <div class="mb-3"><label class="form-label" asp-for="Confirm">@L["Confirm new password"]</label><input class="form-control" asp-for="Confirm" autocomplete="new-password" dir="ltr" /></div>
        <button class="btn btn-primary">@L["Save"]</button>
    }
    else { <p class="mb-0">@L["This account signs in with Windows; no password to change."]</p> }
</form></div></div>
