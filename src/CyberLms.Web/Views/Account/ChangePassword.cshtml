@model ChangePasswordVm
@{ ViewData["Title"] = L["Change password"]; }
<h1 class="h4 mb-3">@L["Change password"]</h1>
@if (User.FindFirst("must_change_password")?.Value == "1") { <div class="alert alert-info">You must change your password before continuing.</div> }
<div class="card" style="max-width:480px"><div class="card-body">
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @if ((bool)ViewBag.Local)
    {
        <div class="mb-3"><label class="form-label">@L["Current password"]</label><input class="form-control" asp-for="Current" autocomplete="current-password" /><span class="text-danger" asp-validation-for="Current"></span></div>
        <div class="mb-3"><label class="form-label">@L["New password"]</label><input class="form-control" asp-for="New" autocomplete="new-password" /><div class="form-text">Minimum 10 characters, with upper-case, lower-case and a digit.</div><span class="text-danger" asp-validation-for="New"></span></div>
        <div class="mb-3"><label class="form-label">@L["Confirm new password"]</label><input class="form-control" asp-for="Confirm" autocomplete="new-password" /><span class="text-danger" asp-validation-for="Confirm"></span></div>
        <button class="btn btn-primary">@L["Save"]</button>
    }
    else { <p class="mb-0">This account signs in with Windows.</p> }
</form></div></div>
