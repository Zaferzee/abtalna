@model List<AssessmentAttempt>
@{ ViewData["Title"] = L["My Results"]; var acks = (List<UserAcknowledgment>)ViewBag.Acks; var passed = Model.Count(t => t.Passed == true); }
<div class="page-head reveal">
    <div>
        <div class="eyebrow"><i class="bi bi-award"></i> @L["Learning"]</div>
        <h1>@L["My Results"]</h1>
        <p class="lead">@L["Your completed assessments and the policies you have acknowledged."]</p>
    </div>
    <div class="cluster">
        <span class="chip chip-success"><i class="bi bi-patch-check"></i> @L.Format("{0} passed", passed)</span>
        <span class="chip chip-primary"><i class="bi bi-pen"></i> @L.Format("{0} acknowledged", acks.Count)</span>
    </div>
</div>
<section class="panel mb-4 reveal" style="--i:1">
    <div class="panel-head"><h2><i class="bi bi-clipboard-check"></i> @L["Completed assessments"]</h2></div>
    @if (Model.Count == 0)
    {
        <div class="empty py-4"><div class="empty-icon"><i class="bi bi-trophy"></i></div><p>@L["No completed assessments yet."]</p><a class="btn btn-primary mt-2" asp-controller="Assessments" asp-action="Index">@L["Assessments"]</a></div>
    }
    else
    {
        @foreach (var t in Model)
        {
            <a class="result-row" asp-controller="Assessments" asp-action="Result" asp-route-id="@t.Id">
                <span style="--ring-color:var(--color-@(t.Passed == true ? "success" : "danger"))">@Ui.Ring((double)t.Percentage, size: 48, stroke: 9)</span>
                <span class="r-main"><strong class="bidi">@t.Assessment.Title</strong><small>@L["Correct answers"]: @t.CorrectAnswers @L.Format("of {0}", t.TotalQuestions) · @Time.Html(t.CompletedAt)</small></span>
                <span class="badge text-bg-@(t.Passed == true ? "success" : "danger")">@L[t.Passed == true ? "Passed" : "Failed"]</span>
                <span class="small fw-semibold text-primary d-none d-md-inline">@L["View details"] <i class="bi bi-arrow-left-short flip-rtl"></i></span>
            </a>
        }
    }
</section>
<section class="panel reveal" style="--i:2">
    <div class="panel-head"><h2><i class="bi bi-pen"></i> @L["My acknowledgments"]</h2></div>
    @if (acks.Count == 0)
    {
        <div class="empty py-4"><div class="empty-icon"><i class="bi bi-pen"></i></div><p>@L["You have not acknowledged any policy yet."]</p></div>
    }
    else
    {
        <div class="table-responsive"><table class="table mb-0"><thead><tr><th>@L["Title"]</th><th>@L["Acknowledgment date"]</th></tr></thead><tbody>
        @foreach (var a in acks) { <tr><td class="bidi"><i class="bi bi-check-circle-fill text-success"></i> <a asp-controller="Content" asp-action="Details" asp-route-id="@a.ContentId">@a.Content.Title</a></td><td>@Time.Html(a.AcknowledgedAt)</td></tr> }
        </tbody></table></div>
    }
</section>
