@model ReportVm
@{ ViewData["Title"] = "Reports"; }
<h1 class="h4 mb-3">Reports</h1>
<partial name="_Tabs" /><partial name="_Filter" model="Model" />
<div class="card"><div class="table-responsive"><table class="table table-sm table-hover mb-0">
<thead><tr><th>User</th><th>Name</th><th>Department</th><th>Assessment</th><th>Status</th><th>Best score</th><th>Attempts</th><th>Last attempt</th></tr></thead><tbody>
@foreach (var r in Model.Assessments)
{
    <tr><td dir="ltr">@r.Username</td><td class="bidi">@r.DisplayName</td><td class="bidi">@r.Department</td><td class="bidi">@r.Assessment</td>
        <td><span class="badge text-bg-@Labels.Badge(r.Status)">@Labels.Status(r.Status)</span></td>
        <td>@(r.BestPercentage?.ToString("0.#") + (r.BestPercentage == null ? "-" : "%"))</td><td>@r.Attempts</td><td>@Time.Format(r.LastAttempt)</td></tr>
}
@if (Model.Assessments.Count == 0) { <tr><td colspan="8" class="text-muted text-center py-4">No rows. (Only published assessments and active users with the User role are included.)</td></tr> }
</tbody></table></div></div>
<partial name="_Pager" model="Model.Pager" />
<form method="post" asp-action="Remind" class="mt-3" data-confirm="Email a reminder to every user who has not attempted (for the current assessment filter)?">
    <input type="hidden" name="kind" value="assessment" /><input type="hidden" name="assessmentId" value="@Model.Filter.AssessmentId" />
    <button class="btn btn-outline-secondary"><i class="bi bi-envelope"></i> Email reminder to users who have not attempted</button>
</form>
