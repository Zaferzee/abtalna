@model ReportVm
@{ ViewData["Title"] = L["Reports"]; }
<partial name="_Head" />
<partial name="_Tabs" /><partial name="_Filter" model="Model" />
<div class="card table-card reveal" style="--i:1">
<partial name="_ResultsBar" model="Model" />
<div class="table-responsive"><table class="table table-hover mb-0">
<thead><tr><th>@L["User"]</th><th>@L["Department"]</th><th>@L["Assessment"]</th><th>@L["Status"]</th><th>@L["Best score"]</th><th>@L["Attempts"]</th><th>@L["Last attempt date"]</th></tr></thead><tbody>
@foreach (var r in Model.Assessments)
{
    <tr>
        <td><div class="user-cell"><span class="avatar avatar-sm">@(r.DisplayName.Trim().Length > 0 ? r.DisplayName.Trim()[0] : '?')</span><div><strong class="bidi">@r.DisplayName</strong><small dir="ltr">@r.Username</small></div></div></td>
        <td class="bidi">@r.Department</td><td class="bidi">@r.Assessment</td>
        <td><span class="badge badge-dot text-bg-@Labels.Badge(r.Status)">@L[Labels.Status(r.Status)]</span></td>
        <td>@if (r.BestPercentage is decimal bp) { <div class="score-cell"><div class="meter"><span class="@(r.Status == "Passed" ? "ok" : "bad")" data-w="@bp"></span></div>@Ui.Pct((double)bp)</div> } else { <span class="text-muted">-</span> }</td>
        <td>@r.Attempts</td><td>@Time.Html(r.LastAttempt)</td>
    </tr>
}
@if (Model.Assessments.Count == 0) { <tr><td colspan="7"><div class="empty py-4"><div class="empty-icon"><i class="bi bi-search"></i></div><p>@L["No results. Only published assessments and active employees are included."]</p></div></td></tr> }
</tbody></table></div>
</div>
<partial name="_Pager" model="Model.Pager" />
<form method="post" asp-action="Remind" class="mt-3" data-confirm="@L["Email a reminder to every user who has not attempted (for the current assessment filter)?"]">
    <input type="hidden" name="kind" value="assessment" /><input type="hidden" name="assessmentId" value="@Model.Filter.AssessmentId" />
    <button class="btn btn-outline-secondary"><i class="bi bi-envelope"></i> @L["Email a reminder to users who have not attempted"]</button>
</form>
