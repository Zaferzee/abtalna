@model ReportVm
@{ ViewData["Title"] = L["Reports"]; }
<h1 class="h4 mb-3">@L["Reports"]</h1>
<partial name="_Tabs" /><partial name="_Filter" model="Model" />
<div class="card"><div class="table-responsive"><table class="table table-sm table-hover mb-0">
<thead><tr><th>@L["Username"]</th><th>@L["Name"]</th><th>@L["Department"]</th><th>@L["Assessment"]</th><th>@L["Status"]</th><th>@L["Best score"]</th><th>@L["Attempts"]</th><th>@L["Last attempt date"]</th></tr></thead><tbody>
@foreach (var r in Model.Assessments)
{
    <tr><td dir="ltr" class="text-end">@r.Username</td><td class="bidi">@r.DisplayName</td><td class="bidi">@r.Department</td><td class="bidi">@r.Assessment</td>
        <td><span class="badge text-bg-@Labels.Badge(r.Status)">@L[Labels.Status(r.Status)]</span></td>
        <td>@(r.BestPercentage?.ToString("0.#") + (r.BestPercentage == null ? "-" : "%"))</td><td>@r.Attempts</td><td>@Time.Html(r.LastAttempt)</td></tr>
}
@if (Model.Assessments.Count == 0) { <tr><td colspan="8" class="text-muted text-center py-4">@L["No results. Only published assessments and active employees are included."]</td></tr> }
</tbody></table></div></div>
<partial name="_Pager" model="Model.Pager" />
<form method="post" asp-action="Remind" class="mt-3" data-confirm="@L["Email a reminder to every user who has not attempted (for the current assessment filter)?"]">
    <input type="hidden" name="kind" value="assessment" /><input type="hidden" name="assessmentId" value="@Model.Filter.AssessmentId" />
    <button class="btn btn-outline-secondary"><i class="bi bi-envelope"></i> @L["Email a reminder to users who have not attempted"]</button>
</form>
