@model AttemptDetailVm
@{ ViewData["Title"] = L["Attempt details"]; var a = Model.Attempt; var n = 0; }
<nav aria-label="@L["Breadcrumb trail"]"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Attempts">@L["Attempts and scores"]</a></li><li class="breadcrumb-item active" aria-current="page">@L["Attempt details"]</li></ol></nav>
<h1 class="h4 bidi">@a.Assessment.Title</h1>
<p><span class="bidi">@a.User.DisplayName</span> (<bdi dir="ltr">@a.User.Username</bdi>) &middot; @Time.Html(a.StartedAt) &rarr; @Time.Html(a.CompletedAt) &middot; <strong>@a.Percentage.ToString("0.#")%</strong>
    <span class="badge text-bg-@(a.Passed == true ? "success" : "danger")">@L[a.Passed == true ? "Passed" : "Failed"]</span>
    &middot; @L["Passing score"]: @a.PassingPercentageSnapshot% &middot; @L["Correct answers"]: @a.CorrectAnswers / @a.TotalQuestions</p>
@foreach (var q in Model.Questions)
{
    n++; var ans = Model.Answers[q.Id];
    <div class="card question-card mb-2"><div class="card-body">
        <div class="d-flex justify-content-between gap-2"><div class="fw-semibold bidi">@n. @q.Text</div><span class="badge text-bg-@(ans.IsCorrect ? "success" : "danger") align-self-start">@L[ans.IsCorrect ? "Correct" : "Incorrect"] (@ans.PointsAwarded/@q.Points)</span></div>
        <ul class="list-unstyled mb-0 mt-2">@foreach (var o in q.Options.OrderBy(o => o.SortOrder)) { var sel = ans.SelectedOptionIds.Contains(o.Id); <li class="bidi"><i class="bi bi-@(sel ? "check-square-fill" : "square")"></i> @(q.Type == QuestionType.TrueFalse ? L[o.Text] : o.Text) @if (o.IsCorrect) { <span class="badge text-bg-success">@L["Correct answer"]</span> }</li> }</ul>
    </div></div>
}
