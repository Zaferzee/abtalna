@model ReportVm
@{ ViewData["Title"] = "Reports"; }
<h1 class="h4 mb-3">Reports</h1>
<partial name="_Tabs" /><partial name="_Filter" model="Model" />
<div class="card"><div class="table-responsive"><table class="table table-sm table-hover mb-0">
<thead><tr><th>User</th><th>Name</th><th>Department</th><th>Content</th><th>Status</th><th>Acknowledged at</th><th></th></tr></thead><tbody>
@foreach (var r in Model.Acks)
{
    <tr><td dir="ltr">@r.Username</td><td class="bidi">@r.DisplayName</td><td class="bidi">@r.Department</td><td class="bidi">@r.Content</td>
        <td><span class="badge text-bg-@Labels.Badge(r.Status)">@Labels.Status(r.Status)</span></td><td>@Time.Format(r.AcknowledgedAt)</td>
        <td class="text-end">@if (r.AcknowledgedAt != null) { <form method="post" asp-controller="Content" asp-action="ResetAcknowledgments" asp-route-id="@r.ContentId" asp-route-userId="@r.UserId" class="d-inline" data-confirm="Reset this user's acknowledgment?"><button class="btn btn-sm btn-outline-danger">Reset</button></form> }</td></tr>
}
@if (Model.Acks.Count == 0) { <tr><td colspan="7" class="text-muted text-center py-4">No rows. (Only published content that requires acknowledgment is included.)</td></tr> }
</tbody></table></div></div>
<partial name="_Pager" model="Model.Pager" />
<form method="post" asp-action="Remind" class="mt-3" data-confirm="Email a reminder to every user who has not acknowledged (for the current content filter)?">
    <input type="hidden" name="kind" value="ack" /><input type="hidden" name="contentId" value="@Model.Filter.ContentId" />
    <button class="btn btn-outline-secondary"><i class="bi bi-envelope"></i> Email reminder to users who have not acknowledged</button>
</form>
