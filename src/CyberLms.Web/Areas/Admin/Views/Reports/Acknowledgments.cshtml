@model ReportVm
@{ ViewData["Title"] = L["Reports"]; }
<partial name="_Head" />
<partial name="_Tabs" /><partial name="_Filter" model="Model" />
<div class="card table-card reveal" style="--i:1">
<partial name="_ResultsBar" model="Model" />
<div class="table-responsive"><table class="table table-hover mb-0">
<thead><tr><th>@L["Username"]</th><th>@L["Name"]</th><th>@L["Department"]</th><th>@L["Content"]</th><th>@L["Status"]</th><th>@L["Acknowledgment date"]</th><th><span class="visually-hidden">@L["Actions"]</span></th></tr></thead><tbody>
@foreach (var r in Model.Acks)
{
    <tr><td dir="ltr" class="text-end">@r.Username</td><td class="bidi">@r.DisplayName</td><td class="bidi">@r.Department</td><td class="bidi">@r.Content</td>
        <td><span class="badge badge-dot text-bg-@Labels.Badge(r.Status)">@L[Labels.Status(r.Status)]</span></td><td>@Time.Html(r.AcknowledgedAt)</td>
        <td class="text-end">@if (r.AcknowledgedAt != null) { <form method="post" asp-controller="Content" asp-action="ResetAcknowledgments" asp-route-id="@r.ContentId" asp-route-userId="@r.UserId" class="d-inline" data-confirm="@L["Reset this user's acknowledgment?"]"><button class="btn btn-sm btn-outline-danger">@L["Reset"]</button></form> }</td></tr>
}
@if (Model.Acks.Count == 0) { <tr><td colspan="7" class="text-muted text-center py-4">@L["No results. Only published content that requires acknowledgment is included."]</td></tr> }
</tbody></table></div>
</div>
<partial name="_Pager" model="Model.Pager" />
<form method="post" asp-action="Remind" class="mt-3" data-confirm="@L["Email a reminder to every user who has not acknowledged (for the current content filter)?"]">
    <input type="hidden" name="kind" value="ack" /><input type="hidden" name="contentId" value="@Model.Filter.ContentId" />
    <button class="btn btn-outline-secondary"><i class="bi bi-envelope"></i> @L["Email a reminder to users who have not acknowledged"]</button>
</form>
