@model ContentFormVm
@{ ViewData["Title"] = Model.Id == 0 ? "New content" : "Edit content"; }
@section Head { <link rel="stylesheet" href="~/lib/quill/quill.snow.css" /> }
@section PreScripts { <script src="~/lib/quill/quill.js"></script> }
<h1 class="h4 mb-3">@ViewData["Title"]</h1>
<form method="post" enctype="multipart/form-data">
<div class="row g-3">
<div class="col-lg-8">
    <div class="card mb-3"><div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3"><label class="form-label" asp-for="Title"></label><input class="form-control bidi" asp-for="Title" maxlength="300" /><span class="text-danger" asp-validation-for="Title"></span></div>
        <div class="mb-3"><label class="form-label" asp-for="Description"></label><textarea class="form-control bidi" asp-for="Description" rows="2" maxlength="2000"></textarea></div>
        <div class="mb-1"><label class="form-label">Body</label>
            <input type="hidden" asp-for="Body" /><div data-quill-for="Body"></div></div>
    </div></div>
    <div class="card"><div class="card-header bg-white fw-semibold">Attachments &amp; links</div><div class="card-body">
        @if (Model.Attachments.Count > 0)
        {
            <ul class="list-group mb-3">
            @foreach (var a in Model.Attachments)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-@(a.Kind == AttachmentKind.Image ? "image" : a.Kind == AttachmentKind.Video ? "camera-video" : "file-earmark-text")"></i> 
                        <a href="@Url.Action("Attachment", "Files", new { area = "", id = a.Id })" target="_blank">@a.FileName</a> <small class="text-muted">@Labels.Size(a.SizeBytes)</small></span>
                    <button class="btn btn-sm btn-outline-danger" formmethod="post" formaction="@Url.Action("DeleteAttachment", new { id = a.Id })" formnovalidate data-confirm-click="Remove this file?">Remove</button>
                </li>
            }
            </ul>
        }
        <div class="mb-3"><label class="form-label">Upload files (images, PDF/Office documents, MP4/WebM video)</label>
            <input class="form-control" type="file" name="files" multiple accept="@StorageService.AcceptList" /></div>
        <div class="mb-0"><label class="form-label" asp-for="ExternalUrl"></label><input class="form-control" dir="ltr" asp-for="ExternalUrl" placeholder="https://intranet/… or /path" /><span class="text-danger" asp-validation-for="ExternalUrl"></span></div>
    </div></div>
</div>
<div class="col-lg-4">
    <div class="card mb-3"><div class="card-body">
        <div class="mb-3"><label class="form-label" asp-for="Type">Content type</label>
            <select class="form-select" asp-for="Type">@foreach (var t in Enum.GetValues<ContentType>()) { <option value="@((int)t)" selected="@(Model.Type == t)">@Labels.Type(t)</option> }</select></div>
        <div class="form-check form-switch mb-3"><input class="form-check-input" type="checkbox" asp-for="RequiresAcknowledgment" /><label class="form-check-label" asp-for="RequiresAcknowledgment">Requires acknowledgment</label></div>
        @if (Model.Id != 0) { <div class="mb-3">Status: <span class="badge text-bg-@(Model.Status == ContentStatus.Published ? "success" : "secondary")">@Model.Status</span></div> }
        <div class="d-grid gap-2">
        @if (Model.Id == 0)
        {
            <button class="btn btn-primary" name="publish" value="true">Save &amp; publish</button>
            <button class="btn btn-outline-secondary" name="publish" value="false">Save as draft</button>
        }
        else
        {
            <button class="btn btn-primary" name="command" value="save">Save</button>
            @if (Model.Status != ContentStatus.Published) { <button class="btn btn-success" name="command" value="publish">Save &amp; publish</button> }
        }
        <a class="btn btn-link" asp-action="Index">Cancel</a>
        </div>
    </div></div>
    @if (Model.Id != 0 && Model.RequiresAcknowledgment)
    {
        <div class="card"><div class="card-body"><div class="fw-semibold mb-2">Acknowledgments</div>
            <a class="btn btn-sm btn-outline-primary mb-2" asp-controller="Reports" asp-action="Acknowledgments" asp-route-contentId="@Model.Id">View report</a>
            <button class="btn btn-sm btn-outline-danger mb-2" formmethod="post" formaction="@Url.Action("ResetAcknowledgments", new { id = Model.Id })" formnovalidate data-confirm-click="Reset ALL acknowledgments for this content? Users will have to acknowledge again.">Reset all</button>
        </div></div>
    }
</div>
</div>
</form>
