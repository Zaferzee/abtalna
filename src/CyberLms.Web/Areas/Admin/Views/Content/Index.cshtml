@model ContentListVm
@{ ViewData["Title"] = L["Content Management"]; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h4 mb-0">@L["Content Management"]</h1><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> @L["New content"]</a></div>
<form class="row g-2 mb-3" method="get" role="search">
    <div class="col-12 col-md-4"><input class="form-control" name="q" value="@Model.Q" placeholder="@L["Search by title"]" aria-label="@L["Search"]" /></div>
    <div class="col-6 col-md-3"><select class="form-select" name="type" aria-label="@L["Content type"]"><option value="">@L["All types"]</option>@foreach (var t in Enum.GetValues<ContentType>()) { <option value="@((int)t)" selected="@(Model.Type == t)">@L[Labels.Type(t)]</option> }</select></div>
    <div class="col-6 col-md-3"><select class="form-select" name="status" aria-label="@L["Status"]"><option value="">@L["All statuses"]</option><option value="Published" selected="@(Model.Status == ContentStatus.Published)">@L["Published"]</option><option value="Draft" selected="@(Model.Status == ContentStatus.Draft)">@L["Draft"]</option></select></div>
    <div class="col-12 col-md-2"><button class="btn btn-outline-primary w-100"><i class="bi bi-funnel"></i> @L["Filter"]</button></div>
</form>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0">
<thead><tr><th>@L["Title"]</th><th>@L["Content type"]</th><th>@L["Status"]</th><th>@L["Acknowledgments"]</th><th>@L["Created on"]</th><th><span class="visually-hidden">@L["Actions"]</span></th></tr></thead><tbody>
@foreach (var r in Model.Items)
{
    var c = r.Content;
    <tr>
        <td class="bidi"><a asp-action="Edit" asp-route-id="@c.Id">@c.Title</a></td>
        <td>@L[Labels.Type(c.Type)]</td>
        <td><span class="badge text-bg-@(c.Status == ContentStatus.Published ? "success" : "secondary")">@L[Labels.ContentStatus(c.Status)]</span></td>
        <td>@if (c.RequiresAcknowledgment) { <a asp-controller="Reports" asp-action="Acknowledgments" asp-route-contentId="@c.Id">@L.Format("{0} acknowledged", r.Acked)</a> } else { <span class="text-muted">-</span> }</td>
        <td>@Time.Html(c.CreatedAt)</td>
        <td class="text-nowrap text-end">
            <a class="btn btn-sm btn-outline-secondary" asp-area="" asp-controller="Content" asp-action="Details" asp-route-id="@c.Id" title="@L["Preview"]" aria-label="@L["Preview"]"><i class="bi bi-eye"></i></a>
            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id" title="@L["Edit"]" aria-label="@L["Edit"]"><i class="bi bi-pencil"></i></a>
            <form method="post" asp-action="SetStatus" asp-route-id="@c.Id" asp-route-publish="@(c.Status != ContentStatus.Published)" class="d-inline"><button class="btn btn-sm btn-outline-@(c.Status == ContentStatus.Published ? "warning" : "success")">@L[c.Status == ContentStatus.Published ? "Unpublish" : "Publish"]</button></form>
            @if (c.Status == ContentStatus.Published)
            { <form method="post" asp-action="Notify" asp-route-id="@c.Id" class="d-inline" data-confirm="@L["Send an email to all employees (only those who still need to acknowledge, if acknowledgment is required)?"]"><button class="btn btn-sm btn-outline-secondary" title="@L["Email employees"]" aria-label="@L["Email employees"]"><i class="bi bi-envelope"></i></button></form> }
            else
            { <form method="post" asp-action="Delete" asp-route-id="@c.Id" class="d-inline" data-confirm="@L["Delete this content and its files permanently?"]"><button class="btn btn-sm btn-outline-danger" title="@L["Delete"]" aria-label="@L["Delete"]"><i class="bi bi-trash"></i></button></form> }
        </td>
    </tr>
}
@if (Model.Items.Count == 0) { <tr><td colspan="6" class="text-muted text-center py-4">@L["No content found."]</td></tr> }
</tbody></table></div></div>
<partial name="_Pager" model="Model.Pager" />
