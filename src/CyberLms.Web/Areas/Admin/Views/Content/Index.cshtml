@model ContentListVm
@{ ViewData["Title"] = L["Content Management"]; var filtered = !string.IsNullOrEmpty(Model.Q) || Model.Type != null || Model.Status != null; }
<div class="page-head reveal">
    <div>
        <div class="eyebrow"><i class="bi bi-journal-richtext"></i> @L["Manage"]</div>
        <h1>@L["Content Management"]</h1>
        <p class="lead">@L["Policies, controls, awareness and training material shown to employees."]</p>
    </div>
    <div class="page-actions"><a class="btn btn-primary btn-lg" asp-action="Create"><i class="bi bi-plus-lg"></i> @L["New content"]</a></div>
</div>

<div class="card table-card reveal" style="--i:1">
    <form class="toolbar" method="get" role="search">
        <div class="search"><i class="bi bi-search"></i><input class="form-control" name="q" value="@Model.Q" placeholder="@L["Search by title"]" aria-label="@L["Search"]" /></div>
        <select class="form-select" name="type" aria-label="@L["Content type"]"><option value="">@L["All types"]</option>@foreach (var t in Enum.GetValues<ContentType>()) { <option value="@((int)t)" selected="@(Model.Type == t)">@L[Labels.Type(t)]</option> }</select>
        <select class="form-select" name="status" aria-label="@L["Status"]"><option value="">@L["All statuses"]</option><option value="Published" selected="@(Model.Status == ContentStatus.Published)">@L["Published"]</option><option value="Draft" selected="@(Model.Status == ContentStatus.Draft)">@L["Draft"]</option></select>
        <div class="tb-end">
            <button class="btn btn-outline-primary"><i class="bi bi-funnel"></i> @L["Filter"]</button>
            @if (filtered) { <a class="btn btn-ghost" asp-action="Index"><i class="bi bi-x-lg"></i> @L["Clear filters"]</a> }
        </div>
    </form>
    <div class="table-responsive"><table class="table table-hover mb-0">
    <thead><tr><th>@L["Title"]</th><th>@L["Content type"]</th><th>@L["Status"]</th><th>@L["Acknowledgments"]</th><th>@L["Created on"]</th><th class="text-end"><span class="visually-hidden">@L["Actions"]</span></th></tr></thead><tbody>
    @foreach (var r in Model.Items)
    {
        var c = r.Content;
        var published = c.Status == ContentStatus.Published;
        <tr>
            <td><div class="t-title">
                <span class="icon-chip tc type-@((int)c.Type)"><i class="bi @Ui.TypeIcon(c.Type)"></i></span>
                <div class="min-w-0"><a class="t-name bidi" asp-action="Edit" asp-route-id="@c.Id">@c.Title</a>@if (!string.IsNullOrWhiteSpace(c.Description)) { <span class="t-desc bidi">@c.Description</span> }</div>
            </div></td>
            <td class="text-nowrap">@L[Labels.Type(c.Type)]</td>
            <td><span class="badge badge-dot text-bg-@(published ? "success" : "secondary")">@L[Labels.ContentStatus(c.Status)]</span></td>
            <td class="text-nowrap">@if (c.RequiresAcknowledgment) { <a class="chip chip-link" asp-controller="Reports" asp-action="Acknowledgments" asp-route-contentId="@c.Id"><i class="bi bi-check2-square"></i> @L.Format("{0} acknowledged", r.Acked)</a> } else { <span class="text-muted">-</span> }</td>
            <td class="text-nowrap">@Time.Html(c.CreatedAt)</td>
            <td><div class="row-actions">
                <a class="btn btn-sm btn-ghost btn-icon" asp-area="" asp-controller="Content" asp-action="Details" asp-route-id="@c.Id" title="@L["Preview"]" aria-label="@L["Preview"]"><i class="bi bi-eye"></i></a>
                <a class="btn btn-sm btn-ghost btn-icon" asp-action="Edit" asp-route-id="@c.Id" title="@L["Edit"]" aria-label="@L["Edit"]"><i class="bi bi-pencil"></i></a>
                @if (published)
                { <form method="post" asp-action="Notify" asp-route-id="@c.Id" class="d-inline" data-confirm="@L["Send an email to all employees (only those who still need to acknowledge, if acknowledgment is required)?"]"><button class="btn btn-sm btn-ghost btn-icon" title="@L["Email employees"]" aria-label="@L["Email employees"]"><i class="bi bi-envelope"></i></button></form> }
                else
                { <form method="post" asp-action="Delete" asp-route-id="@c.Id" class="d-inline" data-confirm="@L["Delete this content and its files permanently?"]"><button class="btn btn-sm btn-ghost btn-icon text-danger" title="@L["Delete"]" aria-label="@L["Delete"]"><i class="bi bi-trash3"></i></button></form> }
                <form method="post" asp-action="SetStatus" asp-route-id="@c.Id" asp-route-publish="@(!published)" class="d-inline"><button class="btn btn-sm btn-outline-@(published ? "warning" : "success")"><i class="bi @(published ? "bi-pause-circle" : "bi-broadcast")"></i> @L[published ? "Unpublish" : "Publish"]</button></form>
            </div></td>
        </tr>
    }
    @if (Model.Items.Count == 0)
    {
        <tr><td colspan="6"><div class="empty"><div class="empty-icon"><i class="bi bi-journal-plus"></i></div><h3>@L["No content found."]</h3>@if (!filtered) { <p><a class="btn btn-primary mt-2" asp-action="Create"><i class="bi bi-plus-lg"></i> @L["New content"]</a></p> }</div></td></tr>
    }
    </tbody></table></div>
    @if (Model.Pager.Total > 0) { <div class="table-foot"><span class="text-muted small">@L.Format("Total: {0}", Model.Pager.Total)</span></div> }
</div>
<partial name="_Pager" model="Model.Pager" />
