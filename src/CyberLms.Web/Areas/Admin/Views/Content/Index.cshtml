@model ContentListVm
@{ ViewData["Title"] = "Content Management"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h4 mb-0">Content Management</h1><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New content</a></div>
<form class="row g-2 mb-3" method="get">
    <div class="col-12 col-md-4"><input class="form-control" name="q" value="@Model.Q" placeholder="Search title" /></div>
    <div class="col-6 col-md-3"><select class="form-select" name="type"><option value="">All types</option>@foreach (var t in Enum.GetValues<ContentType>()) { <option value="@((int)t)" selected="@(Model.Type == t)">@Labels.Type(t)</option> }</select></div>
    <div class="col-6 col-md-3"><select class="form-select" name="status"><option value="">All statuses</option><option value="Published" selected="@(Model.Status == ContentStatus.Published)">Published</option><option value="Draft" selected="@(Model.Status == ContentStatus.Draft)">Draft</option></select></div>
    <div class="col-12 col-md-2"><button class="btn btn-outline-primary w-100">Filter</button></div>
</form>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0">
<thead><tr><th>Title</th><th>Type</th><th>Status</th><th>Ack.</th><th>Created</th><th></th></tr></thead><tbody>
@foreach (var r in Model.Items)
{
    var c = r.Content;
    <tr>
        <td class="bidi"><a asp-action="Edit" asp-route-id="@c.Id">@c.Title</a></td>
        <td>@Labels.Type(c.Type)</td>
        <td><span class="badge text-bg-@(c.Status == ContentStatus.Published ? "success" : "secondary")">@c.Status</span></td>
        <td>@if (c.RequiresAcknowledgment) { <a asp-controller="Reports" asp-action="Acknowledgments" asp-route-contentId="@c.Id">@r.Acked acknowledged</a> } else { <span class="text-muted">-</span> }</td>
        <td>@Time.Format(c.CreatedAt)</td>
        <td class="text-nowrap text-end">
            <a class="btn btn-sm btn-outline-secondary" asp-area="" asp-controller="Content" asp-action="Details" asp-route-id="@c.Id" title="Preview"><i class="bi bi-eye"></i></a>
            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id" title="Edit"><i class="bi bi-pencil"></i></a>
            <form method="post" asp-action="SetStatus" asp-route-id="@c.Id" asp-route-publish="@(c.Status != ContentStatus.Published)" class="d-inline"><button class="btn btn-sm btn-outline-@(c.Status == ContentStatus.Published ? "warning" : "success")">@(c.Status == ContentStatus.Published ? "Unpublish" : "Publish")</button></form>
            @if (c.Status == ContentStatus.Published)
            { <form method="post" asp-action="Notify" asp-route-id="@c.Id" class="d-inline" data-confirm="Send an email to all employees (only those who still need to acknowledge, if acknowledgment is required)?"><button class="btn btn-sm btn-outline-secondary" title="Email employees"><i class="bi bi-envelope"></i></button></form> }
            else
            { <form method="post" asp-action="Delete" asp-route-id="@c.Id" class="d-inline" data-confirm="Delete this content and its files permanently?"><button class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button></form> }
        </td>
    </tr>
}
</tbody></table></div></div>
<partial name="_Pager" model="Model.Pager" />
