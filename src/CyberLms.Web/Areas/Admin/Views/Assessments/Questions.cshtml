@model QuestionsVm
@{ ViewData["Title"] = L["Questions"]; var a = Model.Assessment; var n = 0; }
<nav aria-label="@L["Breadcrumb trail"]"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">@L["Assessments"]</a></li><li class="breadcrumb-item active bidi" aria-current="page">@a.Title</li></ol></nav>
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div><h1 class="h4 mb-0 bidi">@a.Title</h1>
        <small class="text-muted">@L["Passing percentage"]: @a.PassingPercentage% &middot; @(a.MaxAttempts == 0 ? L["Unlimited attempts"] : L.Format("{0} attempt(s)", a.MaxAttempts)) &middot; <span class="badge text-bg-@(a.IsPublished ? "success" : "secondary")">@L[a.IsPublished ? "Published" : "Draft"]</span></small></div>
    <div>
        @if (Model.Attempts == 0) { <a class="btn btn-primary" asp-action="AddQuestion" asp-route-id="@a.Id"><i class="bi bi-plus-lg"></i> @L["Add question"]</a> }
        <form method="post" asp-action="SetStatus" asp-route-id="@a.Id" asp-route-publish="@(!a.IsPublished)" class="d-inline"><button class="btn btn-@(a.IsPublished ? "warning" : "success")">@L[a.IsPublished ? "Unpublish" : "Publish"]</button></form>
    </div>
</div>
@if (Model.Attempts > 0) { <div class="alert alert-info">@L["This assessment has attempts, so questions are locked to protect historical results. Use Duplicate on the assessments list to create an editable copy."]</div> }
@if (Model.Questions.Count == 0) { <div class="alert alert-light border">@L["No questions yet."]</div> }
@foreach (var q in Model.Questions)
{
    n++;
    <div class="card question-card mb-2"><div class="card-body">
        <div class="d-flex justify-content-between gap-2"><div class="fw-semibold bidi">@n. @q.Text</div>
            <div class="text-nowrap"><span class="badge text-bg-light">@L[Labels.QuestionType(q.Type)]</span> <span class="badge text-bg-light">@L.Format("{0} point(s)", q.Points)</span>
            @if (Model.Attempts == 0)
            {
                <a class="btn btn-sm btn-outline-primary" asp-action="EditQuestion" asp-route-id="@q.Id" title="@L["Edit"]" aria-label="@L["Edit"]"><i class="bi bi-pencil"></i></a>
                <form method="post" asp-action="DeleteQuestion" asp-route-id="@q.Id" class="d-inline" data-confirm="@L["Delete this question?"]"><button class="btn btn-sm btn-outline-danger" title="@L["Delete"]" aria-label="@L["Delete"]"><i class="bi bi-trash"></i></button></form>
            }</div></div>
        <ul class="list-unstyled mb-0 mt-2">@foreach (var o in q.Options.OrderBy(o => o.SortOrder)) { <li class="bidi">@(o.IsCorrect ? Html.Raw("<i class=\"bi bi-check-circle-fill text-success\"></i>") : Html.Raw("<i class=\"bi bi-circle text-muted\"></i>")) @(q.Type == QuestionType.TrueFalse ? L[o.Text] : o.Text) @if (o.IsCorrect) { <span class="visually-hidden">(@L["Correct"])</span> }</li> }</ul>
    </div></div>
}
