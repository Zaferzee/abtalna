@model AssessmentFormVm
@{ ViewData["Title"] = Model.Id == 0 ? L["New assessment"] : L["Edit assessment"]; }
<nav aria-label="@L["Breadcrumb trail"]"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">@L["Assessments"]</a></li><li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li></ol></nav>
<div class="page-head reveal"><div><div class="eyebrow"><i class="bi bi-patch-question"></i> @L["Assessments"]</div><h1>@ViewData["Title"]</h1></div></div>
<section class="panel reveal" style="max-width:760px;--i:1"><div class="panel-body"><form method="post" novalidate>
    <div asp-validation-summary="All" class="validation-summary-errors"></div>
    <div class="mb-3"><label class="form-label" asp-for="Title">@L["Title"]</label><input class="form-control bidi" asp-for="Title" /></div>
    <div class="mb-3"><label class="form-label" asp-for="Description">@L["Description / instructions"]</label><textarea class="form-control bidi" asp-for="Description" rows="3"></textarea></div>
    <div class="mb-3"><label class="form-label" asp-for="ContentId">@L["Linked content (optional)"]</label><select class="form-select" asp-for="ContentId" asp-items="(SelectList)ViewBag.Contents"><option value="">@L["- none -"]</option></select></div>
    <div class="row"><div class="col-6 mb-3"><label class="form-label" asp-for="PassingPercentage">@L["Passing percentage"]</label><input class="form-control" dir="ltr" type="number" asp-for="PassingPercentage" min="0" max="100" /></div>
    <div class="col-6 mb-3"><label class="form-label" asp-for="MaxAttempts">@L["Max attempts (0 = unlimited)"]</label><input class="form-control" dir="ltr" type="number" asp-for="MaxAttempts" min="0" max="100" /></div></div>
    <div class="d-flex gap-2"><button class="btn btn-primary btn-lg"><i class="bi bi-check2"></i> @L["Save"]</button> <a class="btn btn-ghost" asp-action="Index">@L["Cancel"]</a></div>
</form></div></section>
