@model QuestionFormVm
@{ ViewData["Title"] = Model.Id == 0 ? "Add question" : "Edit question"; }
<h1 class="h4 mb-3">@ViewData["Title"]</h1>
<div class="card" style="max-width:820px"><div class="card-body"><form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label class="form-label" asp-for="Text">Question text</label><textarea class="form-control bidi" asp-for="Text" rows="2"></textarea></div>
    <div class="row">
        <div class="col-md-6 mb-3"><label class="form-label" asp-for="Type">Question type</label>
            <select class="form-select" asp-for="Type" id="qtype"><option value="1" selected="@(Model.Type == QuestionType.SingleChoice)">Single choice</option><option value="2" selected="@(Model.Type == QuestionType.TrueFalse)">True / False</option><option value="3" selected="@(Model.Type == QuestionType.MultipleChoice)">Multiple choice (several correct)</option></select></div>
        <div class="col-6 col-md-3 mb-3"><label class="form-label" asp-for="Points"></label><input type="number" class="form-control" asp-for="Points" min="1" /></div>
        <div class="col-6 col-md-3 mb-3"><label class="form-label" asp-for="SortOrder">Order</label><input type="number" class="form-control" asp-for="SortOrder" /></div>
    </div>
    <div id="tf-section" class="mb-3 d-none"><label class="form-label">Correct answer</label>
        <div class="form-check"><input class="form-check-input" type="radio" name="TrueIsCorrect" value="true" id="tft" checked="@Model.TrueIsCorrect" /><label class="form-check-label" for="tft">True</label></div>
        <div class="form-check"><input class="form-check-input" type="radio" name="TrueIsCorrect" value="false" id="tff" checked="@(!Model.TrueIsCorrect)" /><label class="form-check-label" for="tff">False</label></div></div>
    <div id="opt-section" class="mb-3"><label class="form-label">Answer options (leave unused rows empty; tick the correct answer(s))</label>
        @for (var i = 0; i < Model.Options.Count; i++)
        {
            <div class="input-group mb-2 option-row">
                <div class="input-group-text"><input class="form-check-input mt-0 opt-correct" type="radio" name="Correct" value="@i" checked="@Model.Correct.Contains(i)" aria-label="Correct" /></div>
                <input class="form-control bidi" name="Options[@i]" value="@Model.Options[i]" maxlength="1000" placeholder="Option @(i + 1)" />
            </div>
        }</div>
    <button class="btn btn-primary">Save question</button> <a class="btn btn-link" asp-action="Questions" asp-route-id="@Model.AssessmentId">Cancel</a>
</form></div></div>
