@model QuestionFormVm
@{ ViewData["Title"] = Model.Id == 0 ? L["Add question"] : L["Edit question"]; }
<nav aria-label="@L["Breadcrumb trail"]"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">@L["Assessments"]</a></li><li class="breadcrumb-item"><a asp-action="Questions" asp-route-id="@Model.AssessmentId">@L["Questions"]</a></li><li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li></ol></nav>
<div class="page-head reveal"><div><div class="eyebrow"><i class="bi bi-patch-question"></i> @L["Assessments"]</div><h1>@ViewData["Title"]</h1></div></div>
<section class="panel reveal" style="max-width:860px;--i:1"><div class="panel-body"><form method="post" novalidate>
    <div asp-validation-summary="All" class="validation-summary-errors"></div>
    <div class="mb-3"><label class="form-label" asp-for="Text">@L["Question text"]</label><textarea class="form-control bidi" asp-for="Text" rows="2"></textarea></div>
    <div class="row">
        <div class="col-md-6 mb-3"><label class="form-label" asp-for="Type">@L["Question type"]</label>
            <select class="form-select" asp-for="Type" id="qtype"><option value="1" selected="@(Model.Type == QuestionType.SingleChoice)">@L["Single choice"]</option><option value="2" selected="@(Model.Type == QuestionType.TrueFalse)">@L["True / False"]</option><option value="3" selected="@(Model.Type == QuestionType.MultipleChoice)">@L["Multiple choice"]</option></select></div>
        <div class="col-6 col-md-3 mb-3"><label class="form-label" asp-for="Points">@L["Points"]</label><input type="number" dir="ltr" class="form-control" asp-for="Points" min="1" /></div>
        <div class="col-6 col-md-3 mb-3"><label class="form-label" asp-for="SortOrder">@L["Order"]</label><input type="number" dir="ltr" class="form-control" asp-for="SortOrder" /></div>
    </div>
    <div id="tf-section" class="mb-3 d-none"><div class="form-label">@L["Correct answer"]</div>
        <div class="yn-cards compact">
            <label class="yn-card" for="tft"><input type="radio" name="TrueIsCorrect" value="true" id="tft" checked="@Model.TrueIsCorrect" /><span class="yn-icon ok"><i class="bi bi-check-lg"></i></span><strong>@L["True"]</strong></label>
            <label class="yn-card" for="tff"><input type="radio" name="TrueIsCorrect" value="false" id="tff" checked="@(!Model.TrueIsCorrect)" /><span class="yn-icon bad"><i class="bi bi-x-lg"></i></span><strong>@L["False"]</strong></label>
        </div></div>
    <div id="opt-section" class="mb-3"><div class="form-label">@L["Answer options (leave unused rows empty; tick the correct answer(s))"]</div>
        @for (var i = 0; i < Model.Options.Count; i++)
        {
            <div class="opt-row option-row">
                <label class="opt-correct-wrap" title="@L["Correct answer"]"><input class="opt-correct" type="radio" name="Correct" value="@i" checked="@Model.Correct.Contains(i)" aria-label="@L["Correct answer"]" /><span class="opt-key">@(i + 1)</span></label>
                <input class="form-control bidi" name="Options[@i]" value="@Model.Options[i]" maxlength="1000" placeholder="@L.Format("Option {0}", i + 1)" />
            </div>
        }</div>
    <div class="d-flex gap-2"><button class="btn btn-primary btn-lg"><i class="bi bi-check2"></i> @L["Save question"]</button> <a class="btn btn-ghost" asp-action="Questions" asp-route-id="@Model.AssessmentId">@L["Cancel"]</a></div>
</form></div></section>
