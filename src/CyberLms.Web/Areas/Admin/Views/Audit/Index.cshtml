@model List<AuditLog>
@{ ViewData["Title"] = L["Audit log"]; var pager = (Pager)ViewBag.Pager; var actions = (List<string>)ViewBag.Actions; }
<h1 class="h4 mb-3">@L["Audit log"]</h1>
<form class="row g-2 mb-3" method="get" role="search">
    <div class="col-12 col-md-4"><input class="form-control" name="q" value="@ViewBag.Q" placeholder="@L["Search by administrator or details"]" aria-label="@L["Search"]" /></div>
    <div class="col-8 col-md-4"><select class="form-select" name="action" aria-label="@L["Action"]"><option value="">@L["All actions"]</option>@foreach (var a in actions) { <option value="@a" selected="@((string?)ViewBag.Action == a)">@L[a]</option> }</select></div>
    <div class="col-4 col-md-2"><button class="btn btn-outline-primary w-100"><i class="bi bi-funnel"></i> @L["Filter"]</button></div>
</form>
<div class="card"><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>@L["Time"]</th><th>@L["Administrator"]</th><th>@L["Action"]</th><th>@L["Entity"]</th><th>@L["Details"]</th><th>@L["IP address"]</th></tr></thead><tbody>
@foreach (var a in Model) { <tr><td class="text-nowrap">@Time.Html(a.Timestamp)</td><td dir="ltr" class="text-end">@a.Username</td><td>@L[a.Action]</td><td>@L["Entity: " + a.EntityType] <bdi dir="ltr">@a.EntityId</bdi></td><td class="bidi">@a.Details</td><td dir="ltr" class="text-end">@a.IpAddress</td></tr> }
@if (Model.Count == 0) { <tr><td colspan="6" class="text-muted text-center py-4">@L["No activity recorded yet."]</td></tr> }
</tbody></table></div></div>
<partial name="_Pager" model="pager" />
