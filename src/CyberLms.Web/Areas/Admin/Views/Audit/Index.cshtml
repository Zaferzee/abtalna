@model List<AuditLog>
@{ ViewData["Title"] = L["Audit log"]; var pager = (Pager)ViewBag.Pager; var actions = (List<string>)ViewBag.Actions; }
<div class="page-head reveal">
    <div>
        <div class="eyebrow"><i class="bi bi-clock-history"></i> @L["Insights"]</div>
        <h1>@L["Audit log"]</h1>
        <p class="lead">@L["Every administrative change, sign-in and acknowledgment-related action, with time, user and IP address."]</p>
    </div>
</div>
<div class="card table-card reveal" style="--i:1">
    <form class="toolbar" method="get" role="search">
        <div class="search"><i class="bi bi-search"></i><input class="form-control" name="q" value="@ViewBag.Q" placeholder="@L["Search by administrator or details"]" aria-label="@L["Search"]" /></div>
        <select class="form-select" name="action" aria-label="@L["Action"]"><option value="">@L["All actions"]</option>@foreach (var a in actions) { <option value="@a" selected="@((string?)ViewBag.Action == a)">@L[a]</option> }</select>
        <div class="tb-end"><button class="btn btn-outline-primary"><i class="bi bi-funnel"></i> @L["Filter"]</button></div>
    </form>
    <div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>@L["Time"]</th><th>@L["Administrator"]</th><th>@L["Action"]</th><th>@L["Entity"]</th><th>@L["Details"]</th><th>@L["IP address"]</th></tr></thead><tbody>
    @foreach (var a in Model)
    {
        <tr>
            <td class="text-nowrap">@Time.Html(a.Timestamp)</td>
            <td dir="ltr" class="text-end">@a.Username</td>
            <td><span class="audit-action"><span class="t-dot-sm"><i class="bi @Ui.AuditIcon(a.Action)"></i></span>@L[a.Action]</span></td>
            <td class="text-nowrap">@L["Entity: " + a.EntityType] <bdi dir="ltr">@(a.EntityId == null ? "" : "#" + a.EntityId)</bdi></td>
            <td class="bidi">@if (string.IsNullOrWhiteSpace(a.Details)) { <span class="text-muted">-</span> } else { @a.Details }</td>
            <td dir="ltr" class="text-end text-muted small">@a.IpAddress</td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="6"><div class="empty py-4"><div class="empty-icon"><i class="bi bi-activity"></i></div><p>@L["No activity recorded yet."]</p></div></td></tr> }
    </tbody></table></div>
</div>
<partial name="_Pager" model="pager" />
