@model SettingsVm
@{ ViewData["Title"] = L["Settings"]; }
<h1 class="h4 mb-3">@L["Settings"]</h1>
<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#t-brand" type="button" role="tab">@L["Branding"]</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#t-general" type="button" role="tab">@L["General"]</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#t-mail" type="button" role="tab">@L["Email settings (SMTP)"]</button></li>
</ul>
@functions {
    Microsoft.AspNetCore.Html.IHtmlContent Color(string label, string name, string value) => Html.Raw(
        $"<div class=\"col-6 col-md-4 mb-3\"><label class=\"form-label\" for=\"{name}\">{System.Net.WebUtility.HtmlEncode(label)}</label><div class=\"input-group\" dir=\"ltr\">" +
        $"<input type=\"color\" class=\"form-control form-control-color\" value=\"{value}\" data-hex-for=\"{name}\" aria-label=\"{System.Net.WebUtility.HtmlEncode(label)}\">" +
        $"<input class=\"form-control\" dir=\"ltr\" id=\"{name}\" name=\"{name}\" value=\"{value}\" maxlength=\"7\"></div></div>");
}
<div class="tab-content">
<div class="tab-pane fade show active" id="t-brand">
<form method="post" asp-action="SaveBranding" enctype="multipart/form-data" novalidate>
<div class="row g-3">
<div class="col-lg-8">
    <div class="card mb-3"><div class="card-header bg-white fw-semibold">@L["Identity"]</div><div class="card-body row">
        <div class="col-md-6 mb-3"><label class="form-label">@L["Organization name"]</label><input class="form-control bidi" name="OrgName" value="@Model.OrgName" maxlength="150" /></div>
        <div class="col-md-6 mb-3"><label class="form-label">@L["System name"]</label><input class="form-control bidi" name="SystemName" value="@Model.SystemName" maxlength="150" /></div>
        <div class="col-md-6 mb-3"><label class="form-label">@L["Logo (PNG/JPG/WebP/GIF)"]</label><input type="file" class="form-control" name="logo" accept=".png,.jpg,.jpeg,.webp,.gif" />
            @if (Model.HasLogo) { <div class="mt-2 d-flex align-items-center gap-3"><img src="~/Files/Brand?kind=logo&v=@Brand.Current.Version" style="max-height:48px;max-width:160px" alt="@L["Logo"]" /><div class="form-check"><input class="form-check-input" type="checkbox" name="removeLogo" value="true" id="rl" /><label class="form-check-label" for="rl">@L["Remove"]</label></div></div> }</div>
        <div class="col-md-6 mb-3"><label class="form-label">@L["Favicon (ICO/PNG)"]</label><input type="file" class="form-control" name="favicon" accept=".ico,.png" />
            @if (Model.HasFavicon) { <div class="mt-2 d-flex align-items-center gap-3"><img src="~/Files/Brand?kind=favicon&v=@Brand.Current.Version" style="max-height:32px" alt="@L["Favicon"]" /><div class="form-check"><input class="form-check-input" type="checkbox" name="removeFavicon" value="true" id="rf" /><label class="form-check-label" for="rf">@L["Remove"]</label></div></div> }</div>
    </div></div>
    <div class="card mb-3"><div class="card-header bg-white fw-semibold">@L["Colors"]</div><div class="card-body row">
        @Color(L["Primary color"], "PrimaryColor", Model.PrimaryColor) @Color(L["Secondary color"], "SecondaryColor", Model.SecondaryColor) @Color(L["Accent color"], "AccentColor", Model.AccentColor)
        @Color(L["Header background"], "HeaderColor", Model.HeaderColor) @Color(L["Header text"], "HeaderTextColor", Model.HeaderTextColor) <div class="col-md-4"></div>
        @Color(L["Sidebar background"], "SidebarColor", Model.SidebarColor) @Color(L["Sidebar text"], "SidebarTextColor", Model.SidebarTextColor) @Color(L["Login page background"], "LoginBackgroundColor", Model.LoginBackgroundColor)
    </div></div>
    <div class="card mb-3"><div class="card-header bg-white fw-semibold">@L["Login page, welcome text and footer"]</div><div class="card-body row">
        <div class="col-md-6 mb-3"><label class="form-label">@L["Login page title"]</label><input class="form-control bidi" name="LoginTitle" value="@Model.LoginTitle" maxlength="150" /></div>
        <div class="col-md-6 mb-3"><label class="form-label">@L["Login background image (optional)"]</label><input type="file" class="form-control" name="loginBackground" accept=".png,.jpg,.jpeg,.webp" />
            @if (Model.HasLoginBackground) { <div class="form-check mt-2"><input class="form-check-input" type="checkbox" name="removeLoginBackground" value="true" id="rb" /><label class="form-check-label" for="rb">@L["Remove current image"]</label></div> }</div>
        <div class="col-12 mb-3"><label class="form-label">@L["Login page notice"]</label><textarea class="form-control bidi" name="LoginSubtitle" rows="2" maxlength="500">@Model.LoginSubtitle</textarea></div>
        <div class="col-12 mb-3"><label class="form-label">@L["Welcome text (employee dashboard)"]</label><textarea class="form-control bidi" name="WelcomeText" rows="2" maxlength="1000">@Model.WelcomeText</textarea></div>
        <div class="col-12 mb-0"><label class="form-label">@L["Footer text (copyright, contact, etc.)"]</label><input class="form-control bidi" name="FooterText" value="@Model.FooterText" maxlength="500" /></div>
    </div></div>
    <button class="btn btn-primary"><i class="bi bi-check2"></i> @L["Save branding"]</button>
    <button class="btn btn-outline-danger" formaction="@Url.Action("ResetBranding")" formnovalidate data-confirm-click="@L["Reset all branding to defaults and remove uploaded images?"]">@L["Restore defaults"]</button>
</div>
<div class="col-lg-4">
    <div class="card"><div class="card-header bg-white fw-semibold">@L["Preview"]</div><div class="card-body p-0">
        <div class="px-3 py-2" style="background:var(--brand-header);color:var(--brand-header-text)">@Model.SystemName</div>
        <div class="d-flex"><div class="p-2" style="width:35%;background:var(--brand-sidebar);color:var(--brand-sidebar-text)">@L["Dashboard"]<br>@L["Content"]</div><div class="p-2 flex-grow-1"><button type="button" class="btn btn-sm btn-primary">@L["Primary color"]</button> <button type="button" class="btn btn-sm btn-accent">@L["Accent color"]</button></div></div>
        <div class="p-2 small text-muted">@L["The saved theme is shown. Changes apply to all users immediately after saving - no rebuild or restart needed."]</div>
    </div></div>
</div>
</div></form>
</div>

<div class="tab-pane fade" id="t-general"><div class="card" style="max-width:640px"><div class="card-body">
<form method="post" asp-action="SaveGeneral" novalidate>
    <div class="mb-3"><label class="form-label">@L["Public base URL (used for links in emails)"]</label><input class="form-control" dir="ltr" name="BaseUrl" value="@Model.BaseUrl" placeholder="https://lms.company.local" /></div>
    <div class="mb-3"><label class="form-label">@L["Default interface language"]</label><select class="form-select" name="DefaultLanguage"><option value="ar" selected="@(Model.DefaultLanguage == "ar")">@L["Arabic (right-to-left)"]</option><option value="en" selected="@(Model.DefaultLanguage == "en")">@L["English"]</option></select><div class="form-text">@L["Users can switch language from the header at any time."]</div></div>
    <button class="btn btn-primary">@L["Save"]</button>
</form></div></div></div>

<div class="tab-pane fade" id="t-mail"><div class="row g-3"><div class="col-lg-7"><div class="card"><div class="card-body">
<form method="post" asp-action="SaveSmtp" novalidate>
    <div class="row"><div class="col-md-8 mb-3"><label class="form-label">@L["SMTP server"]</label><input class="form-control" dir="ltr" name="SmtpHost" value="@Model.SmtpHost" /></div>
    <div class="col-md-4 mb-3"><label class="form-label">@L["Port"]</label><input type="number" dir="ltr" class="form-control" name="SmtpPort" value="@Model.SmtpPort" /></div></div>
    <div class="row"><div class="col-md-6 mb-3"><label class="form-label">@L["Sender address"]</label><input class="form-control" dir="ltr" name="SmtpSender" value="@Model.SmtpSender" /></div>
    <div class="col-md-6 mb-3"><label class="form-label">@L["Sender name"]</label><input class="form-control bidi" name="SmtpSenderName" value="@Model.SmtpSenderName" /></div></div>
    <div class="row"><div class="col-md-6 mb-3"><label class="form-label">@L["SMTP username (if required)"]</label><input class="form-control" dir="ltr" name="SmtpUsername" value="@Model.SmtpUsername" autocomplete="off" /></div>
    <div class="col-md-6 mb-3"><label class="form-label">@L["Connection security"]</label><select class="form-select" name="SmtpSecurity"><option value="Auto" selected="@(Model.SmtpSecurity == "Auto")">@L["Automatic"]</option><option value="None" selected="@(Model.SmtpSecurity == "None")">@L["None"]</option><option value="StartTls" selected="@(Model.SmtpSecurity == "StartTls")">STARTTLS</option><option value="Ssl" selected="@(Model.SmtpSecurity == "Ssl")">SSL/TLS</option></select></div></div>
    <div class="alert alert-@(Model.SmtpPasswordConfigured ? "success" : "secondary") py-2">@L["SMTP password"]: @L[Model.SmtpPasswordConfigured ? "configured on the server" : "not configured"] @L["(set it in the server configuration or the Smtp__Password environment variable; it is never stored in the database)."]</div>
    <button class="btn btn-primary">@L["Save"]</button>
</form></div></div></div>
<div class="col-lg-5"><div class="card"><div class="card-header bg-white fw-semibold">@L["Send test email"]</div><div class="card-body">
<form method="post" asp-action="TestEmail" novalidate><div class="input-group" dir="ltr"><input class="form-control" dir="ltr" name="to" placeholder="you@company.com" aria-label="@L["Email"]" /><button class="btn btn-outline-primary">@L["Send"]</button></div></form></div></div></div>
</div></div>
</div>
