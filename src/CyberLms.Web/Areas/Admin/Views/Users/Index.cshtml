@model UserListVm
@{ ViewData["Title"] = "Users"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h4 mb-0">Users</h1><div><button class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#import"><i class="bi bi-upload"></i> Import CSV</button> <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New user</a></div></div>
<div class="collapse mb-3" id="import"><div class="card"><div class="card-body">
    <form method="post" asp-action="Import" enctype="multipart/form-data" class="row g-2 align-items-end">
        <div class="col-md-4"><label class="form-label">CSV file (header: username,displayname,email,department)</label><input type="file" class="form-control" name="file" accept=".csv" required /></div>
        <div class="col-md-3"><label class="form-label">Sign-in type</label><select class="form-select" name="authSource"><option value="Windows">Windows / AD (no password)</option><option value="Local">Local (initial password)</option></select></div>
        <div class="col-md-3"><label class="form-label">Initial password (Local only)</label><input type="password" class="form-control" name="initialPassword" autocomplete="new-password" /></div>
        <div class="col-md-2"><button class="btn btn-primary w-100">Import</button></div>
    </form></div></div></div>
<form class="row g-2 mb-3" method="get">
    <div class="col-12 col-md-5"><input class="form-control" name="q" value="@Model.Q" placeholder="Search username, name, email" /></div>
    <div class="col-6 col-md-3"><select class="form-select" name="role"><option value="">All roles</option><option value="Admin" selected="@(Model.Role == "Admin")">Admin</option><option value="User" selected="@(Model.Role == "User")">User</option></select></div>
    <div class="col-6 col-md-2"><button class="btn btn-outline-primary w-100">Filter</button></div>
</form>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0">
<thead><tr><th>Username</th><th>Name</th><th>Email</th><th>Department</th><th>Roles</th><th>Sign-in</th><th>Status</th><th>Last login</th><th></th></tr></thead><tbody>
@foreach (var u in Model.Items)
{
    <tr><td dir="ltr">@u.Username</td><td class="bidi">@u.DisplayName</td><td dir="ltr">@u.Email</td><td class="bidi">@u.Department</td>
        <td>@string.Join(", ", u.UserRoles.Select(r => r.Role.Name))</td><td>@u.AuthSource</td>
        <td><span class="badge text-bg-@(u.IsActive ? "success" : "secondary")">@(u.IsActive ? "Active" : "Disabled")</span></td><td>@Time.Format(u.LastLoginAt)</td>
        <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.Id"><i class="bi bi-pencil"></i></a></td></tr>
}
</tbody></table></div></div>
<partial name="_Pager" model="Model.Pager" />
