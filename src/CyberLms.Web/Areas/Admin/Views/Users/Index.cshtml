@model UserListVm
@{ ViewData["Title"] = L["Users"]; }
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><h1 class="h4 mb-0">@L["Users"]</h1><div><button class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#import"><i class="bi bi-upload"></i> @L["Import from CSV"]</button> <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> @L["New user"]</a></div></div>
<div class="collapse mb-3" id="import"><div class="card"><div class="card-body">
    <form method="post" asp-action="Import" enctype="multipart/form-data" class="row g-2 align-items-end" novalidate>
        <div class="col-md-4"><label class="form-label">@L["CSV file (header: username,displayname,email,department)"]</label><input type="file" class="form-control" name="file" accept=".csv" /></div>
        <div class="col-md-3"><label class="form-label">@L["Sign-in type"]</label><select class="form-select" name="authSource"><option value="Windows">@L["Windows / AD (no password)"]</option><option value="Local">@L["Local (initial password)"]</option></select></div>
        <div class="col-md-3"><label class="form-label">@L["Initial password (Local only)"]</label><input type="password" dir="ltr" class="form-control" name="initialPassword" autocomplete="new-password" /></div>
        <div class="col-md-2"><button class="btn btn-primary w-100">@L["Import"]</button></div>
    </form></div></div></div>
<form class="row g-2 mb-3" method="get" role="search">
    <div class="col-12 col-md-5"><input class="form-control" name="q" value="@Model.Q" placeholder="@L["Search by username, name or email"]" aria-label="@L["Search"]" /></div>
    <div class="col-6 col-md-3"><select class="form-select" name="role" aria-label="@L["Role"]"><option value="">@L["All roles"]</option><option value="Admin" selected="@(Model.Role == "Admin")">@L["Role: Administrator"]</option><option value="User" selected="@(Model.Role == "User")">@L["Role: Employee"]</option></select></div>
    <div class="col-6 col-md-2"><button class="btn btn-outline-primary w-100"><i class="bi bi-funnel"></i> @L["Filter"]</button></div>
</form>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0">
<thead><tr><th>@L["Username"]</th><th>@L["Display name"]</th><th>@L["Email"]</th><th>@L["Department"]</th><th>@L["Role"]</th><th>@L["Sign-in type"]</th><th>@L["Status"]</th><th>@L["Last sign-in"]</th><th><span class="visually-hidden">@L["Actions"]</span></th></tr></thead><tbody>
@foreach (var u in Model.Items)
{
    <tr><td dir="ltr" class="text-end">@u.Username</td><td class="bidi">@u.DisplayName</td><td dir="ltr" class="text-end">@u.Email</td><td class="bidi">@u.Department</td>
        <td>@string.Join(L.Sep, u.UserRoles.Select(r => L[Labels.Role(r.Role.Name)]))</td><td>@L[Labels.AuthSource(u.AuthSource)]</td>
        <td><span class="badge text-bg-@(u.IsActive ? "success" : "secondary")">@L[u.IsActive ? "Active" : "Disabled"]</span></td><td>@Time.Html(u.LastLoginAt)</td>
        <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.Id" title="@L["Edit"]" aria-label="@L["Edit"]"><i class="bi bi-pencil"></i></a></td></tr>
}
@if (Model.Items.Count == 0) { <tr><td colspan="9" class="text-muted text-center py-4">@L["No users found."]</td></tr> }
</tbody></table></div></div>
<partial name="_Pager" model="Model.Pager" />
